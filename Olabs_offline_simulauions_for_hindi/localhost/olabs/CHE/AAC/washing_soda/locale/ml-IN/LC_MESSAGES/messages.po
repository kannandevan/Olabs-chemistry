msgid "HELP"
msgstr "സഹായം"

msgid "Alert"
msgstr "മുന്നറിയിപ്പ്"

msgid "Do you want to reset the simulation"
msgstr "സിമുലേഷൻ പുനഃസജ്ജമാക്കണോ?"

msgid "Yes"
msgstr "അതെ"

msgid "No"
msgstr "ഇല്ല"

msgid "Developed by Amrita University <br> Funded by : Ministry of Electronics and Information Technology || <br> Ministry of Education Government of India"
msgstr "വികസിപ്പിച്ചത് അമൃത സർവ്വകലാശാല <br> ധനസഹായം : ഇലക്ട്രോണിക്സ് ആൻഡ് ഇൻഫർമേഷൻ ടെക്നോളജി മന്ത്രാലയം || <br> വിദ്യാഭ്യാസ മന്ത്രാലയം, ഇന്ത്യൻ ഗവൺമെന്റ്"

msgid "RESET"
msgstr "റീസെറ്റ്"

msgid "MAXIMIZE"
msgstr "വലുതാക്കുക"

msgid "MINIMIZE"
msgstr "ചെറുതാക്കുക"

msgid "To Identify Washing soda or Baking soda among given Samples of Chemicals"
msgstr "നൽകിയിട്ടുള്ള രാസവസ്തുക്കളുടെ സാമ്പിളുകളിൽ നിന്ന് വാഷിംഗ് സോഡാ അല്ലെങ്കിൽ ബേക്കിംഗ് സോഡാ എന്നിവയെ തിരിച്ചറിയാൻ"

msgid "Next"
msgstr "അടുത്തത്"

msgid "The boiling tube A only produces effervescence when dil. HCl is added. <br>Therefore, the further procedure will be done using boiling tube A"
msgstr "നേർപ്പിച്ച HCl ചേർക്കുമ്പോൾ തിളപ്പിക്കൽ ട്യൂബ് A യിൽ മാത്രം എഫർവെസെൻസ് (effervescence) ഉണ്ടാകുന്നു. <br>അതുകൊണ്ട്, തുടർന്നുള്ള നടപടിക്രമം തിളപ്പിക്കൽ ട്യൂബ് A ഉപയോഗിച്ച് ചെയ്യും."

msgid "Wash the glass rod used for one sample before it used for another sample."
msgstr "ഒരു സാമ്പിളിനായി ഉപയോഗിച്ച ഗ്ലാസ് റോഡ് മറ്റൊരു സാമ്പിളിനായി ഉപയോഗിക്കുന്നതിന് മുമ്പ് കഴുകുക."

msgid "Pass the liberated gas evolved through the lime water in a test tube . The lime water turns milky."
msgstr "പുറത്തുവരുന്ന വാതകം ടെസ്റ്റ് ട്യൂബിലെ ചുണ്ണാമ്പുവെള്ളത്തിലൂടെ (ചുണ്ണാമ്പുവെള്ളം) കടത്തിവിടുക. ചുണ്ണാമ്പുവെള്ളം പാൽനിറമായി മാറുന്നു."

msgid "Sodium carbonate decahydrate"
msgstr "സോഡിയം കാർബണേറ്റ് ഡെക്കാഹൈഡ്രേറ്റ്"

msgid "Ammonium chloride"
msgstr "അമോണിയം ക്ലോറൈഡ്"

msgid "Sodium chloride"
msgstr "സോഡിയം ക്ലോറൈഡ്"

msgid "Click on the sodium carbonate decahydrate bottle"
msgstr "സോഡിയം കാർബണേറ്റ് ഡെക്കാഹൈഡ്രേറ്റ് കുപ്പിയിൽ ക്ലിക്കുചെയ്യുക"

msgid "Click on the cap to open the bottle"
msgstr "കുപ്പിയുടെ അടപ്പ് തുറക്കാൻ ക്ലിക്കുചെയ്യുക"

msgid "Drag and drop the Spatula towards the bottle"
msgstr "സ്‌പാറ്റുല കുപ്പിയുടെ അടുത്തേക്ക് വലിച്ചിടുക"

msgid "Drag and drop the Spatula towards the Boiling tube A"
msgstr "സ്‌പാറ്റുല തിളപ്പിക്കൽ ട്യൂബ് A യിലേക്ക് വലിച്ചിടുക"

msgid "Drag and drop the Spatula towards the Boiling tube B"
msgstr "സ്‌പാറ്റുല തിളപ്പിക്കൽ ട്യൂബ് B യിലേക്ക് വലിച്ചിടുക"

msgid "Drag and drop the Spatula towards the Boiling tube C"
msgstr "സ്‌പാറ്റുല തിളപ്പിക്കൽ ട്യൂബ് C യിലേക്ക് വലിച്ചിടുക"

msgid "Click here to shake."
msgstr "കുലുക്കാൻ ഇവിടെ ക്ലിക്കുചെയ്യുക."

msgid "Drag and drop the Measuring Cylinder towards the Boiling tube A."
msgstr "മെഷറിംഗ് സിലിണ്ടർ തിളപ്പിക്കൽ ട്യൂബ് A യിലേക്ക് വലിച്ചിടുക."

msgid "Drag and drop the Measuring Cylinder towards the Boiling tube B."
msgstr "മെഷറിംഗ് സിലിണ്ടർ തിളപ്പിക്കൽ ട്യൂബ് B യിലേക്ക് വലിച്ചിടുക."

msgid "Drag and drop the Measuring Cylinder towards the Boiling tube C."
msgstr "മെഷറിംഗ് സിലിണ്ടർ തിളപ്പിക്കൽ ട്യൂബ് C യിലേക്ക് വലിച്ചിടുക."

msgid "Click on the ammonium chloride bottle."
msgstr "അമോണിയം ക്ലോറൈഡ് കുപ്പിയിൽ ക്ലിക്കുചെയ്യുക."

msgid "Click on the sodium chloride bottle."
msgstr "സോഡിയം ക്ലോറൈഡ് കുപ്പിയിൽ ക്ലിക്കുചെയ്യുക."

