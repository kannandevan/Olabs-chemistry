msgid "Which of the following substances will undergo sublimation?"
msgstr "താഴെ പറയുന്നവയിൽ ഏത് പദാർത്ഥം ഉർവ്വപാതനം പ്രക്രിയയ്ക്ക് വിധേയമാകും?"

msgid "Dry ice"
msgstr "ഡ്രൈ ഐസ്"

msgid "Common salt"
msgstr "സാധാരണ ഉപ്പ്"

msgid "Sugar"
msgstr "പഞ്ചസാര"

msgid "Sand"
msgstr "മണൽ"

msgid "Dry ice"
msgstr "ഡ്രൈ ഐസ്"

msgid "What happens if naphthalene is used instead of ammonium chloride, Will it undergo the sublimation Process"
msgstr "അമ്മോണിയം ക്ലോറൈഡിന് പകരം നാഫ്തലീൻ ഉപയോഗിച്ചാൽ എന്ത് സംഭവിക്കും? അത് ഉർവ്വപാതന പ്രക്രിയയ്ക്ക് വിധേയമാകുമോ?"

msgid "No"
msgstr "ഇല്ല"

msgid "Yes"
msgstr "അതെ"

msgid "Ammonium chloride is an evaporating substance, which directly evaporates on heating without converting into the liquid phase"
msgstr "അമ്മോണിയം ക്ലോറൈഡ് ഒരു വാഷ്പമാകുന്ന പദാർത്ഥമാണ്, ഇത് ചൂട് നൽകുമ്പോൾ ദ്രവാവസ്ഥയിലേക്കു മാറാതെ നേരിട്ട് വാഷ്പമാകും."

msgid "All of these"
msgstr "ഇവയൊക്കെ"

msgid "Ammonium chloride is an evaporating substance, which directly evaporates on heating without converting into the liquid phase"
msgstr "അമ്മോണിയം ക്ലോറൈഡ് ഒരു വാഷ്പമാകുന്ന പദാർത്ഥമാണ്, ഇത് ചൂട് നൽകുമ്പോൾ ദ്രവാവസ്ഥയിലേക്കു മാറാതെ നേരിട്ട് വാഷ്പമാകും."

msgid "Cottons helps in the elimination"
msgstr "പഞ്ച് വാതകങ്ങളെ തടയാൻ സഹായിക്കുന്നു"

msgid "Cotton stops external air from entering the funnel"
msgstr "പഞ്ച് പുറം വായു ഫന്നലിലേക്ക് പ്രവേശിക്കുന്നത് തടയുന്നു"

msgid "In the procedure of sublimation, the inverted funnel is plugged with cotton because __________"
msgstr "ഉർവ്വപാതന പ്രക്രിയയിൽ, മറിച്ച ഫന്നൽ പഞ്ച് ഉപയോഗിച്ച് അടയ്ക്കുന്നത് __________ കാരണം"

msgid "What happens when ammonium chloride is heated?"
msgstr "അമ്മോണിയം ക്ലോറൈഡ് ചൂടാക്കുമ്പോൾ എന്ത് സംഭവിക്കുന്നു?"

msgid "Forms Ammonia and HCl"
msgstr "അമോണിയയും ഹൈഡ്രോക്ലോറിക് ആസിഡും രൂപപ്പെടുന്നു"

msgid "No changes"
msgstr "ഏതെങ്കിലും മാറ്റം സംഭവിക്കുന്നില്ല"

msgid "Forms Ammonia and HCl"
msgstr "അമോണിയയും ഹൈഡ്രോക്ലോറിക് ആസിഡും രൂപപ്പെടുന്നു"

