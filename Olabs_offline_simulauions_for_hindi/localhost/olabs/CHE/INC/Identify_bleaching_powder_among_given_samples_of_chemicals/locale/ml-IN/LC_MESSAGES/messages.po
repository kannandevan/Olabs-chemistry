msgstr "ദ്രാവകം B"

#: simcontrols.js:26
msgid "Solution C"
msgstr "ദ്രാവകം C"

#: simcontrols.js:27
msgid "Solution D"
msgstr "ദ്രാവകം D"

#: simcontrols.js:28
msgid "50ml Solution"
msgstr "50ml ദ്രാവകം"

#: simcontrols.js:29
msgid "20ml Dil.Sulphuric Acid"
msgstr "<empty class="pxdot8">20ml ഡൈല്യൂട്ട്<br>സൾഫ്യൂറിക് ആസിഡ്<empty>"

#: simcontrols.js:30
msgid "Cotton Cloth"
msgstr "<empty class="pxdot7">പട്ടിനൂൽ തുണി<empty>"






