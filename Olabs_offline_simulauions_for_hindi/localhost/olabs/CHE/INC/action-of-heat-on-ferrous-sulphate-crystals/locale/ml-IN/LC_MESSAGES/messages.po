#: simcontrols.js:100
msgid "To start the experiment,</br>click on the Switch on button."
msgstr "പരീക്ഷണം തുടങ്ങുന്നതിന് ബട്ടനിലെ </br>സ്വിച്ച് 'On' ൽ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:100
msgid "Click on the reset button</br>to redo the experiment."
msgstr "പരീക്ഷണം വീണ്ടും ആവർത്തിക്കുന്നതിന് പുനഃക്രമീകരണ ബട്ടൻ</br> ക്ലിക്ക് ചെയ്യുക."

