msgstr "ബർണറിന് മുകളിലേക്ക് ടെസ്ട്യുബ്  നീക്കി വെച്ചിട്ട്</br> സംയുക്തം ചൂടാക്കുക."

#: simcontrols.js:100
msgid "Move the slider to adjust</br>the rheostat resistance."
msgstr "സ്ലൈഡർ ചലിപ്പിച്ച് റിയോസ്റ്റാറ്റിന്റെ  പ്രതിരോധം</br> ക്രമീകരിക്കുക"

#: simcontrols.js:100
msgid "Click on the switch on button."
msgstr "സ്വിച്ചിൽ ക്ലിക്ക് ചെയ്ത് ബട്ടൻ 'On' ചെയ്യുക"

#: simcontrols.js:100
msgid "Use the slider to adjust</br>the power of the light."
msgstr "പ്രകാശത്തിന്റെ  തീവ്രത ക്രമീകരിക്കുന്നതിന് </br> സ്ലൈഡർ ഉപയോഗിക്കുക."

#: simcontrols.js:100
msgid "Use the slider to adjust the</br>distance of the light source."
msgstr "പ്രകാശ ഉറവിടത്തിന്റെ  ദൂരം ക്രമീകരിക്കുന്നതിന് </br> സ്ലൈഡർ ഉപയോഗിക്കുക."

#: simcontrols.js:100
msgid ""
