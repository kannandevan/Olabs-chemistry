#: simcontrols.js:35
msgid "Study the Process of Filtration"
msgstr "ഫിൽട്രേഷൻ പ്രക്രിയ പഠിക്കുക"

msgid "Instructions:"
msgstr "നിർദ്ദേശങ്ങൾ:"

msgid "1. Drag the funnel and  drop it above the tripod stand. "
msgstr "1. ഫണൽ വലിച്ചിഴച്ച് ട്രൈപോഡ് സ്റ്റാൻഡിന്റെ മുകളിൽ വയ്ക്കുക. "

msgid "2. Click on the filter paper box to open. "
msgstr "2. ഫിൽട്ടർ പേപ്പർ ബോക്സ് തുറക്കാൻ അതിൽ ക്ലിക്ക് ചെയ്യുക. "

msgid "3. Click the filter paper box. "
msgstr "3. ഫിൽട്ടർ പേപ്പർ ബോക്സിൽ ക്ലിക്ക് ചെയ്യുക. "

msgid "4. Click the filter paper. "
msgstr "4. ഫിൽട്ടർ പേപ്പറിൽ ക്ലിക്ക് ചെയ്യുക. "

msgid "5. Click and drag the distilled water and   drop it in the filter paper. "
msgstr "5. ഡിസ്റ്റിൽഡ് വെള്ളത്തിൽ ക്ലിക്ക് ചെയ്ത് വലിച്ചിഴച്ച് ഫിൽട്ടർ പേപ്പറിൽ ഒഴിക്കുക. "

msgid "6. Drag the beaker containing muddy water and drop it above the funnel. "
msgstr "6. മഞ്ഞ് കലർന്ന വെള്ളമുള്ള ബീക്കർ വലിച്ചിഴച്ച് ഫണലിന്റെ മുകളിൽ വയ്ക്കുക. "

msgid "Drag the funnel and <br> drop it above the tripod stand"
msgstr "ഫണൽ വലിച്ചിഴച്ച് <br> ട്രൈപോഡ് സ്റ്റാൻഡിന്റെ മുകളിൽ വയ്ക്കുക"

msgid "Click on the filter paper box to open"
msgstr "ഫിൽട്ടർ പേപ്പർ ബോക്സ് തുറക്കാൻ അതിൽ ക്ലിക്ക് ചെയ്യുക"

msgid "Click the filter paper box"
msgstr "ഫിൽട്ടർ പേപ്പർ ബോക്സിൽ ക്ലിക്ക് ചെയ്യുക"

msgid "Click the filter paper"
msgstr "ഫിൽട്ടർ പേപ്പറിൽ ക്ലിക്ക് ചെയ്യുക"

msgid "Click and drag the distilled water and <br>  drop it in the filter paper"
msgstr "ഡിസ്റ്റിൽഡ് വെള്ളത്തിൽ ക്ലിക്ക് ചെയ്ത് വലിച്ചിഴച്ച് <br> ഫിൽട്ടർ പേപ്പറിൽ ഒഴിക്കുക"

msgid "Drag the beaker <br>containing muddy water and drop it above the funnel"
msgstr "മഞ്ഞ് കലർന്ന വെള്ളമുള്ള ബീക്കർ <br>വലിച്ചിഴച്ച് ഫണലിന്റെ മുകളിൽ വയ്ക്കുക"

msgid "Click on the Reset button to do <br> the experiment again"
msgstr "പരീക്ഷണം വീണ്ടും നടത്താൻ <br> റീസെറ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക"

msgid "Fold the filter paper properly"
msgstr "ഫിൽട്ടർ പേപ്പർ ശരിയായി മടക്കുക"

msgid "After the process of filtration, clear water is obtained.<br> Thus, the solid particle is eliminated."
msgstr "ഫിൽട്രേഷൻ പ്രക്രിയയ്ക്ക് ശേഷം തെളിഞ്ഞ വെള്ളം ലഭിക്കുന്നു.<br> അതിനാൽ ഘനകണങ്ങൾ നീക്കം ചെയ്യപ്പെടുന്നു."

msgid "Click on the Inference icon"
msgstr "തീരുമാന (Inference) ഐക്കണിൽ ക്ലിക്ക് ചെയ്യുക"
