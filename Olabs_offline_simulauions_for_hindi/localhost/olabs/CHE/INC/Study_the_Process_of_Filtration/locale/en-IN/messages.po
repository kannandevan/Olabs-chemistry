#: simcontrols.js:35
msgid "Study the Process of Filtration"
msgstr "Study the Process of Filtration"

msgid "Instructions:"
msgstr "Instructions:"

msgid "1. Drag the funnel and  drop it above the tripod stand. "
msgstr "1. Drag the funnel and  drop it above the tripod stand. "

msgid "2. Click on the filter paper box to open. "
msgstr "2. Click on the filter paper box to open. "

msgid "3. Click the filter paper box. "
msgstr "3. Click the filter paper box. "

msgid "4. Click the filter paper. "
msgstr "4. Click the filter paper. "

msgid "5. Click and drag the distilled water and   drop it in the filter paper. "
msgstr "5. Click and drag the distilled water and   drop it in the filter paper. "

msgid "6. Drag the beaker containing muddy water and drop it above the funnel. "
msgstr "6. Drag the beaker containing muddy water and drop it above the funnel. "

msgid "Drag the funnel and <br> drop it above the tripod stand"
msgstr "Drag the funnel and <br> drop it above the tripod stand"

msgid "Click on the filter paper box to open"
msgstr "Click on the filter paper box to open"

msgid "Click the filter paper box"
msgstr "Click the filter paper box"

msgid "Click the filter paper"
msgstr "Click the filter paper"

msgid "Click and drag the distilled water and <br>  drop it in the filter paper"
msgstr "Click and drag the distilled water and <br>  drop it in the filter paper"

msgid "Drag the beaker <br>containing muddy water and drop it above the funnel"
msgstr "Drag the beaker <br>containing muddy water and drop it above the funnel"

msgid "Click on the Reset button to do <br> the experiment again"
msgstr "Click on the Reset button to do <br> the experiment again"

msgid "Fold the filter paper properly"
msgstr "Fold the filter paper properly"

msgid "After the process of filtration, clear water is obtained.<br> Thus, the solid particle is eliminated."
msgstr "After the process of filtration, clear water is obtained.<br> Thus, the solid particle is eliminated."

msgid "Click on the Inference icon"
msgstr "Click on the Inference icon"