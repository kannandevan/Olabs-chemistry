msgid "Combustion Test"
msgstr "ദഹന പരീക്ഷണം"

msgid "Reactions of NaOH with Aluminium Metal and HCl"
msgstr "NaOH ന്റെ അലുമിനിയം ലോഹത്തോടും HCl നോടുമുള്ള പ്രതികരണങ്ങൾ"

msgid "Developed by Amrita University Under research grant from <br> Department of Electronics & Information Technology"
msgstr "ഇലക്ട്രോണിക്സ് & ഇൻഫർമേഷൻ ടെക്നോളജി വകുപ്പിന്റെ <br> ഗവേഷണ ധനസഹായത്തോടെ അമൃത യൂണിവേഴ്സിറ്റിയാൽ വികസിപ്പിച്ചത്"

msgid "Select the compound"
msgstr "സംയുക്തം തിരഞ്ഞെടുക്കുക"

msgid "Drag the spatula towards<br> the test tube to drop <br>aluminium metal into test tube"
msgstr "അലുമിനിയം ലോഹം ടെസ്റ്റ് ട്യൂബിലേക്ക് ഇടുന്നതിനായി<br> സ്പാചുല ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the measuring cylinder towards<br> the test tube to drop 5ml NaOH"
msgstr "5ml NaOH ഒഴിക്കാൻ<br> അളക്കുന്ന സിലിണ്ടർ ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag moist red litmus towards the test tube"
msgstr "നനഞ്ഞ ചുവപ്പ് ലിറ്റ്മസ് പേപ്പർ ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag moist blue litmus paper<br>towards the test tube"
msgstr "നനഞ്ഞ നീല ലിറ്റ്മസ് പേപ്പർ<br> ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Click on the button','Click on knob of the burner"
msgstr "ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക','ബർണറിന്റെ നൊബിൽ ക്ലിക്ക് ചെയ്യുക"

msgid "Drag the test tube towards the burner"
msgstr "ടെസ്റ്റ് ട്യൂബ് ബർണറിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the candle towards the test tube"
msgstr "മെഴുകുതിരി ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the dropper towards the measuring <br> cylinder to drop 2ml dil.Hcl"
msgstr "2ml dilute HCl ഒഴിക്കാൻ ഡ്രോപ്പർ<br> അളക്കുന്ന സിലിണ്ടറിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the measuring cylinder <br>towards the test tube"
msgstr "അളക്കുന്ന സിലിണ്ടർ ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the test tube towards the left"
msgstr "ടെസ്റ്റ് ട്യൂബ് ഇടത്തോട്ട് വലിക്കുക"

msgid "Drag the dropper towards the <br> measuring cylinder to drop 3ml dil.Hcl"
msgstr "3ml dilute HCl ഒഴിക്കാൻ<br> ഡ്രോപ്പർ അളക്കുന്ന സിലിണ്ടറിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the measuring cylinder<br> towards the test tube to<br> drop the solution"
msgstr "ദ്രാവകം ഒഴിക്കാൻ<br> അളക്കുന്ന സിലിണ്ടർ ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the red litmus <br>paper towards the test tube"
msgstr "ചുവപ്പ് ലിറ്റ്മസ് പേപ്പർ ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Drag the blue litmus paper<br> towards the test tube"
msgstr "നീല ലിറ്റ്മസ് പേപ്പർ ടെസ്റ്റ് ട്യൂബിന്റെ ദിശയിലേക്ക് വലിക്കുക"

msgid "Click on the Reset button to redo the experiment"
msgstr "പരീക്ഷണം വീണ്ടും നടത്താൻ റീസെറ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക"

msgid "Never smell chemical substance directly close to your nose"
msgstr "രാസവസ്തുക്കൾ ഒരിക്കലും നേരിട്ട് മൂക്കിനടുത്ത് വാസനയിടരുത്"

msgid "In the lab do the experiment again<br> because the Hydrogen gas get out quickly"
msgstr "ഹൈഡ്രജൻ വാതകം വേഗത്തിൽ പുറത്തേക്ക് പോകുന്നതിനാൽ<br> ലബോറട്ടറിയിൽ പരീക്ഷണം വീണ്ടും നടത്തുക"

msgid "Colourless gas is coming out.No characteristic smell for H<sub>2</sub> gas"
msgstr "നിറമില്ലാത്ത വാതകം പുറത്തേക്ക് വരുന്നു. H<sub>2</sub> വാതകത്തിന് പ്രത്യേക ഗന്ധമില്ല"

msgid "No colour change in red litmus because of the neutral nature of H<sub>2</sub> Gas"
msgstr "H<sub>2</sub> വാതകത്തിന്റെ നിഷ്പക്ഷ സ്വഭാവം മൂലം ചുവപ്പ് ലിറ്റ്മസിൽ നിറമാറ്റം സംഭവിക്കുന്നില്ല"

msgid "No colour change in blue litmus because of the neutral nature of H<sub>2</sub> Gas."
msgstr "H<sub>2</sub> വാതകത്തിന്റെ നിഷ്പക്ഷ സ്വഭാവം മൂലം നീല ലിറ്റ്മസിലും നിറമാറ്റം സംഭവിക്കുന്നില്ല."

msgid "Hydrogen burns out at the mouth of test tube with pop sound"
msgstr "ഹൈഡ്രജൻ ടെസ്റ്റ് ട്യൂബിന്റെ വായ്ക്കൽ 'പോപ്പ്' ശബ്ദത്തോടെ കത്തുന്നു"

msgid "The solution is neutral to litmus paper<br>(No colour change of litmus takes place PH=7)"
msgstr "ദ്രാവകം ലിറ്റ്മസ് പേപ്പറിനോട് നിഷ്പക്ഷമാണ്<br>(ലിറ്റ്മസിന്റെ നിറം മാറ്റമില്ല, PH=7)"

msgid "The test tube is warm after the addition of complete HCL"
msgstr "മുഴുവൻ HCl ചേർത്തതിന് ശേഷം ടെസ്റ്റ് ട്യൂബ് ചൂടാണ്"

msgid "Moist Litmus paper"
msgstr "നനഞ്ഞ ലിറ്റ്മസ് പേപ്പർ"

msgid "Aluminium Metal"
msgstr "അലുമിനിയം ലോഹം"

msgid "NaOH"
msgstr "NaOH"

msgid "Litmus paper"
msgstr "ലിറ്റ്മസ് പേപ്പർ"

msgid "5ml dil NaOH"
msgstr "5ml dilute NaOH"

msgid "Dil hcl"
msgstr "dilute HCl"

msgid "Select the compound:"
msgstr "സംയുക്തം തിരഞ്ഞെടുക്കുക:"

msgid "Reset"
msgstr "റീസെറ്റ്"

msgid "Aluminium metal"
msgstr "അലുമിനിയം ലോഹം"

msgid "Hydrochloric acid"
msgstr "ഹൈഡ്രോക്ലോറിക് ആസിഡ്"