msgstr "Esterification reaction between alcohol and carboxylic acid"

#: simcontrols.js:32
msgid "click on next button"
msgstr "click on next button"

#: simcontrols.js:33
msgid "Next"
msgstr "Next"

#: simcontrols.js:34
msgid ""
"Drag the measuring cylinder<br> containing 3 mL ethanol into test tube<br> "
"containing 3 mL ethanoic acid."
msgstr ""
"Drag the measuring cylinder<br> containing 3 mL ethanol into test tube<br> "
"containing 3 mL ethanoic acid."

#: simcontrols.js:35
msgid ""
"Drag the dropper from the conc. H<sub>2</sub>SO<sub>4</sub> bottle with 5 "
"drops ofconc.H<sub>2</sub>SO<sub>4</sub> into the test tube"
msgstr ""
"Drag the dropper from the conc. H<sub>2</sub>SO<sub>4</sub> bottle with 5 "
"drops ofconc.H<sub>2</sub>SO<sub>4</sub> into the test tube"

#: simcontrols.js:35
msgid "Drag a cork over the mouth of the test tube"
msgstr "Drag a cork over the mouth of the test tube"

#: simcontrols.js:35
msgid "Drag the testube towards <br> the beaker containing water"
msgstr "Drag the testube towards <br> the beaker containing water"

#: simcontrols.js:35
msgid "Drag a thermometer into the testube"
msgstr "Drag a thermometer into the testube"

#: simcontrols.js:35
msgid "Click on the burner knob<br> to heat the water in the beaker"
msgstr "Click on the burner knob<br> to heat the water in the beaker"

#: simcontrols.js:35
msgid "Click on the burner knob again to turn off flame"
msgstr "Click on the burner knob again to turn off flame"

#: simcontrols.js:36
msgid "Drag the testube to shake"
msgstr "Drag the testube to shake"

#: simcontrols.js:36
msgid "Click on the cork to open it"
msgstr "Click on the cork to open it"

#: simcontrols.js:36
msgid ""
"Drag the testube to pour into <br> the beaker containing aquaeous "
"NAHCO<sub>3</sub>"
msgstr ""
"Drag the testube to pour into <br> the beaker containing aquaeous "
"NAHCO<sub>3</sub>"

#: simcontrols.js:36
msgid "Click on the Inference button"
msgstr "Click on the Inference button"

#: simcontrols.js:37
msgid ""
"We observe a fruity smell of ester, Ethanoic acid has vinegar like<br> smell "
"and Ethanol has sweet and pungent smell"
msgstr ""
"We observe a fruity smell of ester, Ethanoic acid has vinegar like<br> smell "
"and Ethanol has sweet and pungent smell"

#: simcontrols.js:38
msgid "Reset"
msgstr "Reset"

