msgstr "അനുമാപനത്തിന്റെ തന്മാത്രകളുടെ എണ്ണം, n2"

#: simcontrols.js:9
msgid "No of moles of titrate, n1"
msgstr "അനുമാപനത്തിന്റെ തന്മാത്രകളുടെ എണ്ണം, n1"

#: simcontrols.js:9
msgid "Molar mass of titrant, b"
msgstr "അനുമാപനത്തിന്റെ തന്മാത്രാ പിണ്ഡം, b"

#: simcontrols.js:9
msgid "Strength of given titrant, [a xb]"
msgstr "തന്നിരിക്കുന്ന അനുമാപനത്തിന്റെ ദൃഢത, [a xb]"

#: simcontrols.js:9
msgid "Show volume of titrant, V2"
msgstr "അനുമാപനത്തിന്റെ വോളിയം കാണിക്കുക, V2"

#: simcontrols.js:9
msgid "Temperature: "
msgstr "താപനില:"

#: simcontrols.js:10
msgid "Mohr<sup>&#39;</sup>s salt"
msgstr "മോഹ്ർ സാൾട്ട്"

#: simcontrols.js:10
msgid "Oxalic acid"
msgstr "ഓക്സാലിക് ആസിഡ്"

#: simcontrols.js:11
msgid "Start"
msgstr "ആരംഭിക്കുക"

#: simcontrols.js:11
msgid "Stop"
msgstr "നിർത്തുക"

#: simcontrols.js:12
msgid "Correct."
msgstr "ശരി "

#: simcontrols.js:12
msgid "Wrong! Try Again"
msgstr "തെറ്റ്! വീണ്ടും ശ്രമിക്കുക"

#: simcontrols.js:13
msgid "Burette"
msgstr "ബ്യൂറെറ്റ്"

#: simcontrols.js:13
msgid "Titration flask"
msgstr "അനുമാപന ഫ്ലാസ്ക്"

#: simcontrols.js:13
msgid "Clamp stand"
msgstr "ക്ലാംപ് സ്റ്റാൻഡ്"

#: simcontrols.js:13
msgid "Click on the nozzle or start button to start the titration."
msgstr "അനുമാപനം ആരംഭിക്കാൻ നോസിലില്‍ അല്ലെങ്കിൽ ആരംഭ ബട്ടണില്‍ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:13
msgid "Click on the nozzle or stop button to stop the titration."
msgstr "അനുമാപനം അവസാനിപ്പിക്കാന്‍ നോസിലില്‍ അല്ലെങ്കിൽ 'നിർത്തുക' ബട്ടണില്‍ ക്ലിക്ക് ചെയ്യുക. "

#: simcontrols.js:13
msgid "Click on the reset button to reset the titration."
msgstr "അനുമാപനം പുനഃക്രമീകരിക്കാൻ റീസെറ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:13
msgid "Burner"
msgstr "ബർണര്‍"

#: simcontrols.js:14
msgid "Reset"
msgstr "റീസെറ്റ്"

#: simcontrols.js:15
msgid "Select the titrate."
msgstr "അനുമാപനം തിരഞ്ഞെടുക്കുക."

#: simcontrols.js:15
msgid "Increase/decrease the drops rate."
msgstr "ഡ്രോപ്സ് റേറ്റ് വർദ്ധിപ്പിക്കുക/കുറയ്ക്കുക."

#: simcontrols.js:15
msgid "Change the molarity of the titrate."
msgstr "അനുമാപനത്തിന്റെ മൊളാരിറ്റി മാറ്റുക."

#: simcontrols.js:15
msgid "Change the volume of the titrate."
msgstr "അനുമാപനത്തിന്റെ വോളിയം മാറ്റുക."

#: simcontrols.js:15
msgid "Drag the test tube and </br> pour the  Sulphuric acid into </br> the conical flask containing </br> Mohr<sup>&#39;</sup>s salt."
msgstr "ടെസ്റ്റ് ട്യൂബ് ഡ്രാഗ് ചെയ്ത് </br> മോഹര്‍ സാൾട്ട്  അടങ്ങിയ </br> കോണിക്കല്‍ ഫ്ലാസ്ക്കിലേക്ക് സൾഫ്യൂറിക്ക് ആസിഡ് ഒഴിക്കുക."

#: simcontrols.js:15
msgid "Drag the conical flask and <br> place it below the burette."
msgstr "കോണിക്കല്‍ ഫ്ലാസ്ക് ഡ്രാഗ് ചെയ്ത് <br>അതിനെ ബ്യൂറെറ്റിന് താഴെ വയ്ക്കുക."

#: simcontrols.js:15
msgid "Click on the nozzle or  </br> start button to start the titration."
msgstr "അനുമാപനം ആരംഭിക്കാൻ നോസിലില്‍ അല്ലെങ്കിൽ ആരംഭ ബട്ടണില്‍ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:15
msgid "Click on the checkbox to show volume of titrant."
msgstr "അനുമാപനത്തിന്റെ വോളിയം കാണിക്കുവാന്‍ ചെക്ക്ബോക്സില്‍ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:15
msgid "Drag the conical flask and <br> place it above the burner."
msgstr "ചൂടാക്കുന്നത് ആരംഭിക്കുവാന്‍<br>ബർണര്‍ നോബില്‍ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:15
msgid "Click on the burner <br> knob to start heating."
msgstr "ചൂടാക്കുന്നത് ആരംഭിക്കുവാന്‍<br>ബർണര്‍ നോബില്‍ ക്ലിക്ക് ചെയ്യുക."

#: simcontrols.js:15
msgid "Drag the test tube and </br> pour the  Sulphuric acid into </br> the conical flask containing </br> Oxalic acid."
msgstr "ടെസ്റ്റ് ട്യൂബ് ഡ്രാഗ് ചെയ്ത് </br> ഓക്സാലിക് ആസിഡ് അടങ്ങിയ </br> കോണിക്കല്‍ ഫ്ലാസ്കിലേക്ക് സൾഫ്യൂറിക്ക് ആസിഡ് ഒഴിക്കുക."
