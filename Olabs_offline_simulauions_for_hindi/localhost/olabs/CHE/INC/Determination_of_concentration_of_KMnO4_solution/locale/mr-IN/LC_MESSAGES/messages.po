#: simcontrols.js:4
msgid "Determination of Concentration/Molarity of KMnO<sub>4</sub> solution"
msgstr "KMnO4 द्रावणाची संहत तीव्रता/ग्राम रेणुकता निर्धारित करणे"

#: simcontrols.js:5
msgid "HELP"
msgstr "मदत"

#: simcontrols.js:6
msgid "FULL SCREEN"
msgstr "FULL SCREEN"

#: simcontrols.js:7
msgid "EXIT"
msgstr "EXIT"

#: simcontrols.js:8
