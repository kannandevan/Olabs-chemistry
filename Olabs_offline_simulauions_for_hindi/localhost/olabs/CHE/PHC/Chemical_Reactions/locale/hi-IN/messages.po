msgstr "सूखी बर्फ की उदात्तीकरण बनाने की क्रिया"

#: simcontrols.js:52
msgid "Na<sub>2</sub>SO<sub>4</sub> (aq) with BaCl<sub>2</sub> (aq)"
msgstr "Na<sub>2</sub>SO<sub>4</sub> (aq) साथ BaCl<sub>2</sub> (aq)"

#: simcontrols.js:52
msgid "Iron nail with CuSO<sub>4</sub>   (aq)"
msgstr "लोहे की कील के साथ CuSO<sub>4</sub>   (aq)"

#: simcontrols.js:52
msgid "Heating of CuSO<sub>4</sub>"
msgstr "के ताप CuSO<sub>4</sub>"

#: simcontrols.js:52
