msgstr "बर्फ का पिघलना"

#: simcontrols.js:52
msgid "Zinc with dil.H<sub>2</sub>SO<sub>4</sub>"
msgstr "जिंक के साथ dil.H<sub>2</sub>SO<sub>4</sub>"

#: simcontrols.js:52
msgid "Litmus test"
msgstr "लिट्मस परीक्षण"

#: simcontrols.js:52
