msgstr "हायड्रोजन पॉप परिक्षा"

#: simcontrols.js:52
msgid "ZnSO<sub>4</sub> (aq) with NaOH"
msgstr "ZnSO4 (द्र) आणि NaOH"

#: simcontrols.js:52
msgid "ZnSO<sub>4</sub> (aq) with H<sub>2</sub>S gas"
msgstr "ZnSO4 (द्र) आणि H2S वायु"

#: simcontrols.js:52
