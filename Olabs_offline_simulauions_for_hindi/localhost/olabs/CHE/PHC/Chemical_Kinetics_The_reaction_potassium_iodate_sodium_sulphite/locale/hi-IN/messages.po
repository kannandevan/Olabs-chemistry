msgid "STOP"
msgstr "रुकें"

#: simcontrols.js:19
msgid "Select the volume of <br>potassium iodate solution."
msgstr "<br> पोटेशियम आयोडेट के विलयन की मात्रा का चयन करें।"

#: simcontrols.js:19
msgid "Drag the potassium iodate<br> solution to the measuring jar."
msgstr "मापने वाले जार की ओर पोटेशियम आयोडेट का <br> विलयन खींचें।"

#: simcontrols.js:19
msgid "Drag the measuring jar to the <br>conical flask to pour the solution."
msgstr "विलयन डालने के लिए<br> शंक्वाकार कुप्पी् की ओर मापने वाला जार खींचें ।"

#: simcontrols.js:19
msgid "Drag the sulphuric acid <br>to the measuring jar."
msgstr "मापने वाले जार की ओर सल्फ्यूरिक अम्ल <br> खींचें।"

#: simcontrols.js:19
msgid "Drag the water to<br> the measuring jar."
msgstr "मापने वाले जार <br> की ओर पानी खींचें।"

#: simcontrols.js:19
msgid "Drag the starch solution<br> to the measuring jar."
msgstr "मापने वाले जार की ओर <br> स्टार्च का विलयन खींचें।"

#: simcontrols.js:19
msgid "Drag the sodium sulphite<br> solution to the measuring jar."
msgstr "मापने वाले जार की ओर सोडियम सल्फाइट का <br> विलयन खींचें।"

