#: simcontrols.js:4
msgid "BaCl<sub>2</sub>"
msgstr "BaCl<sub>2</sub>"

#: simcontrols.js:4
msgid "Na<sub>2</sub>SO<sub>4</sub>"
msgstr "Na<sub>2</sub>SO<sub>4</sub>"

#: simcontrols.js:4
msgid "Dil.HCl"
msgstr "विरल HCl"

#: simcontrols.js:4
msgid "Back"
msgstr "मागे"

#: simcontrols.js:5
msgid "HELP"
msgstr "मदत"

#: simcontrols.js:42
msgid "Double Displacement Reaction"
msgstr "द्विविस्थापन अभिक्रिया "

#: simcontrols.js:47
msgid "Instructions"
msgstr "निर्देश"

#: simcontrols.js:49
msgid ""
"<li>Drag the dropper to add BaCl<sub>2</sub> to the test tube.</li><br />"
msgstr "BaCl2 परिक्षा नळीत ओतण्यासाठी, त्याच्या कडे ड्रॉपर ओढा."

#: simcontrols.js:49
msgid ""
"<li>Drag the dropper to add Na<sub>2</sub>SO<sub>4</sub> to the test tube.</"
"li><br />"
msgstr "Na2SO4 परिक्षा नळीत ओतण्यासाठी, त्याच्या कडे ड्रॉपर ओढा."

#: simcontrols.js:49
msgid ""
"<li>Drag the test tube to decant the upper solution to the beaker.</li><br />"
msgstr "परिक्षा नळीतले वरचे द्रावण चंचुपात्रात ओतण्यासाठी , परिक्षा नळी चंचुपात्राकडे ओढा."

#: simcontrols.js:49
msgid "<li>Drag the dropper to add HCl to the test tube.</li><br />"
msgstr "परिक्षा नळीत विरल HCl ओतण्यासाठी, त्याच्या कडे ड्रॉपर ओढा."

#: simcontrols.js:49
msgid "<li>Click on the test tube to zoom in.</li><br />"
msgstr "परिक्षा नळीचे झूम्ड दृश्य बघण्यासाठी त्यावर क्लिक करा."

#: simcontrols.js:50
msgid "Drag the dropper to add BaCl<sub>2</sub><br/>to the test tube."
msgstr "BaCl2 परिक्षा नळीत ओतण्यासाठी, त्याच्या कडे ड्रॉपर ओढा."

#: simcontrols.js:50
msgid ""
"Drag the dropper to add Na<sub>2</sub>SO<sub>4</sub><br/>to the test tube."
msgstr "Na2SO4 परिक्षा नळीत ओतण्यासाठी, त्याच्या कडे ड्रॉपर ओढा."

#: simcontrols.js:50
msgid "Drag the test tube to decant<br/>the upper solution to the beaker."
msgstr "परिक्षा नळीतले वरचे द्रावण चंचुपात्रात ओतण्यासाठी , परिक्षा नळी चंचुपात्राकडे ओढा."

#: simcontrols.js:50
msgid "Drag the dropper to add HCl<br/>to the test tube."
msgstr "परिक्षा नळीत विरल HCl ओतण्यासाठी, त्याच्या कडे ड्रॉपर ओढा."

#: simcontrols.js:50
msgid "A white precipitate of barium sulphate is formed."
msgstr "बेरियम सल्फेटचे पांढरे अवक्षेपण निर्माण झालेले दिसेल."

#: simcontrols.js:50
msgid "The precipitate obtained is insoluble in dil.HCl."
msgstr "हे अवक्षेपण विरल HCl मध्ये विरघळत नाही"

#: simcontrols.js:51
msgid "Reset"
msgstr "रीसेट करा"
