#: simcontrols.js:4
msgid "BaCl<sub>2</sub>"
msgstr "BaCl<sub>2</sub>"

#: simcontrols.js:4
msgid "Na<sub>2</sub>SO<sub>4</sub>"
msgstr "Na<sub>2</sub>SO<sub>4</sub>"

#: simcontrols.js:4
msgid "Dil.HCl"
msgstr "Dil.HCl"

#: simcontrols.js:4
msgid "Back"
msgstr "वापस"

#: simcontrols.js:5
msgid "HELP"
msgstr "HELP"

#: simcontrols.js:42
msgid "Double Displacement Reaction"
msgstr "दोहरी विस्थापन अभिक्रिया"

#: simcontrols.js:47
msgid "Instructions"
msgstr "निर्देश"

#: simcontrols.js:49
msgid ""
"<li>Drag the dropper to add BaCl<sub>2</sub> to the test tube.</li><br />"
msgstr "<li>टेस्ट ट्यूब   में  BaCl <sub>2</sub> मिलाने के लिए ड्रॉपर खींचें</li><br />"

#: simcontrols.js:49
msgid ""
"<li>Drag the dropper to add Na<sub>2</sub>SO<sub>4</sub> to the test tube.</"
"li><br />"
msgstr ""
"<li>टेस्ट ट्यूब में Na<sub>2</sub>SO<sub>4</sub>  मिलाने के लिए ड्रॉपर खींचें </li><br />"

#: simcontrols.js:49
msgid ""
"<li>Drag the test tube to decant the upper solution to the beaker.</li><br />"
msgstr "<li>बीकर में ऊपरी विलयन (साल्‍यूशन) छानने के लिए टेस्ट ट्यूब खींचें।</li><br />"

#: simcontrols.js:49
msgid "<li>Drag the dropper to add HCl to the test tube.</li><br />"
msgstr "<li>टेस्ट ट्यूब में एचसीएल मिलाने की ड्रॉपर खींचें।  </li><br /> "

#: simcontrols.js:49
msgid "<li>Click on the test tube to zoom in.</li><br />"
msgstr "<li>ज़ूम  करने के लिए टेस्ट ट्यूब पर क्लिक करें। </li><br />"

#: simcontrols.js:50
msgid "Drag the dropper to add BaCl<sub>2</sub><br/>to the test tube."
msgstr "टेस्ट ट्यूब में BaCl <sub> 2 </ sub> <br/> मिलाने के लिए ड्रॉपर खींचें।"

#: simcontrols.js:50
msgid ""
"Drag the dropper to add Na<sub>2</sub>SO<sub>4</sub><br/>to the test tube."
msgstr "टेस्ट ट्यूब में Na<sub>2</sub>SO<sub>4</sub><br/> मिलाने की ड्रॉपर खींचें।"

#: simcontrols.js:50
msgid "Drag the test tube to decant<br/>the upper solution to the beaker."
msgstr "बीकर में ऊपरी विलयन (साल्‍यूशन) छानने<br/> के लिए टेस्ट ट्यूब खींचें।"

#: simcontrols.js:50
msgid "Drag the dropper to add HCl<br/>to the test tube."
msgstr "टेस्ट ट्यूब को एचसीएल <br/> मिलाने के लिए ड्रॉपर खींचें।"

#: simcontrols.js:50
msgid "A white precipitate of barium sulphate is formed."
msgstr "बेरियम सल्फेट की सफेद तलछट (प्रेसीपिटेट) बन जाती है।"

#: simcontrols.js:50
msgid "The precipitate obtained is insoluble in dil.HCl."
msgstr "प्राप्त तलछट (प्रेसीपिटेट) तनु (डाइल्‍यूट) एचसीएल में अघुलनशील है।"

#: simcontrols.js:51
msgid "Reset"
msgstr "रीसेट"
