msgid "Click on the knob of the burner to turn it on."
msgstr "Click on the knob of the burner to turn it on."

#: simcontrols.js:76
msgid "Drag the beaker and place it over the Bunsen burner to gently heat it."
msgstr "Drag the beaker and place it over the Bunsen burner to gently heat it."

#: simcontrols.js:89 simcontrols.js:816
msgid "Click on the knob of the burner to turn it off."
msgstr "Click on the knob of the burner to turn it off."

#: simcontrols.js:95 simcontrols.js:149 simcontrols.js:357
msgid "Click on the test tube to move it up."
msgstr "Click on the test tube to move it up."

