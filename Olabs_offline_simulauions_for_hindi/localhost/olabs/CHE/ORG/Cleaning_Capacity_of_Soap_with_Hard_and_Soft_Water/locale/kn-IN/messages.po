msgid "Click on the close button to go to previous stage."
msgstr "Click on the close button to go to previous stage."

#: simcontrols.js:113 simcontrols.js:125
msgid "Click on the test tube to zoom it."
msgstr "Click on the test tube to zoom it."

#: simcontrols.js:119 simcontrols.js:577
msgid "Click on the test tube to shake it up and down."
msgstr "Click on the test tube to shake it up and down."

