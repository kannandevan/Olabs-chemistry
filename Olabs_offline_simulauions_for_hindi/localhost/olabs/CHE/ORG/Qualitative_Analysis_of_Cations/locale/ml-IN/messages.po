#: simcontrols_main.js:247
msgid "White precipitate is due to the formation of<br> manganese hydroxide, Mn(OH)<sub>2</sub>."
msgstr "മാംഗനീസ് ഹൈഡ്രോക്സൈഡിന്റെ (Mn(OH)<sub>2</sub>) രൂപീകരണം മൂലമാണ് വെളുത്ത അവക്ഷിപ്തം."

#: simcontrols_main.js:247
msgid "Mn(OH)<sub>2</sub> turns brown on adding Br<sub>2</sub> water due to <br>the oxidation of Mn(OH)<sub>2</sub> to MnO(OH)<sub>2</sub>.<br> Presence of Mn<sup>2+</sup> is confirmed."
msgstr "Mn(OH)<sub>2</sub> ഓക്സീകരിക്കപ്പെട്ട്  MnO(OH)<sub>2</sub> ആകുന്നതുകാരണം Br<sub>2</sub> ജലംചേർക്കുമ്പോള്‍ Mn(OH)<sub>2</sub> തവിട്ടുനിറമാകുന്നു. Mn<sup>2+</sup>യുടെ സാന്നിധ്യം സ്ഥിരീകരിക്കപ്പെടുന്നു."

#: simcontrols_main.js:248
msgid "The green precipitate is due to the formation of Ni(OH)<sub>2</sub>."
