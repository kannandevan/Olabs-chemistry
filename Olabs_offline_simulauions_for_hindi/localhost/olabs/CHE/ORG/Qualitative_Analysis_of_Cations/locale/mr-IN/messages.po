msgstr "कोळसा पोकळी परीक्षेनंतर राहिलेले अवशेष."

#: simcontrols_main.js:218
msgid "Cobalt nitrate "
msgstr "कोबाल्ट नायट्रेट\t"

#: simcontrols_main.js:219
msgid "May be Mg<sup>2+</sup> is present."
msgstr "Mg2+ उपस्थित असू शकते."

#: simcontrols_main.js:220
msgid "May be due to the presence of Al<sup>3+</sup>."
msgstr "Al3+ उपस्थित असल्यामुळे होऊ शकते."

#: simcontrols_main.js:221
msgid ""
"Drag the dropper towards the charcoal box to<br>add cobalt nitrate solution into the "
