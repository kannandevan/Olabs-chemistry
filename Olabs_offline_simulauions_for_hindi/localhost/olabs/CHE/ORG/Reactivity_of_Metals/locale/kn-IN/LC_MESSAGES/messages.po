#: simcontrols.js:103
msgid ""
"Al is more reactive than Cu and it can displace Cu from </br>CuSO<sub>4 </"
"sub>solution and forms colourless solution of Al<sub>2</sub>(SO<sub>4</sub>)"
"<sub>3</sub>."
msgstr ""
"Al is more reactive than Cu and it can displace Cu from </br>CuSO<sub>4 </"
"sub>solution and forms colourless solution of Al<sub>2</sub>(SO<sub>4</sub>)"
"<sub>3</sub>."

#: simcontrols.js:103
msgid ""
"Al is more reactive than Zn and it can displace Zn from </br>ZnSO<sub>4 </"
"sub>solution and forms colourless solution of Al<sub>2</sub>(SO<sub>4</sub>)"
"<sub>3</sub>."
msgstr ""
"Al is more reactive than Zn and it can displace Zn from </br>ZnSO<sub>4 </"
"sub>solution and forms colourless solution of Al<sub>2</sub>(SO<sub>4</sub>)"
"<sub>3</sub>."

#: simcontrols.js:103
msgid ""
"Al is more reactive than Fe and it can displace Fe from </br>FeSO<sub>4 </"
"sub>solution and forms colourless solution of Al<sub>2</sub>(SO<sub>4</sub>)"
"<sub>3</sub>."
msgstr ""
"Al is more reactive than Fe and it can displace Fe from </br>FeSO<sub>4 </"
"sub>solution and forms colourless solution of Al<sub>2</sub>(SO<sub>4</sub>)"
"<sub>3</sub>."

#: simcontrols.js:106
msgid ""
"Zn is more reactive than Cu and it can displace Cu from </br>CuSO<sub>4</"
"sub> solution and forms colourless solution of ZnSO<sub>4</sub>."
msgstr ""
"Zn is more reactive than Cu and it can displace Cu from </br>CuSO<sub>4</"
"sub> solution and forms colourless solution of ZnSO<sub>4</sub>."

#: simcontrols.js:106
msgid ""
"No change is observed. Because Zn is less reactive than Al </br>so it cannot "
"displace Al from Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</sub> solution."
msgstr ""
"No change is observed. Because Zn is less reactive than Al </br>so it cannot "
"displace Al from Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</sub> solution."

#: simcontrols.js:106
msgid ""
"Zn is more reactive than Fe and it can displace Fe from </br>FeSO<sub>4</"
"sub> solution and forms colourless solution of ZnSO<sub>4</sub>."
msgstr ""
"Zn is more reactive than Fe and it can displace Fe from </br>FeSO<sub>4</"
"sub> solution and forms colourless solution of ZnSO<sub>4</sub>."

#: simcontrols.js:109
msgid ""
"Fe is is more reactive than Cu and it can displace Cu from </br>CuSO<sub>4</"
"sub> solution and forms light green coloured FeSO<sub>4</sub> solution."
msgstr ""
"Fe is is more reactive than Cu and it can displace Cu from </br>CuSO<sub>4</"
"sub> solution and forms light green coloured FeSO<sub>4</sub> solution."

#: simcontrols.js:109
msgid ""
"No change is observed. This indicates that Fe is less reactive </br>than Zn "
"so it cannot displace Zn from ZnSO<sub>4</sub> solution."
msgstr ""
"No change is observed. This indicates that Fe is less reactive </br>than Zn "
"so it cannot displace Zn from ZnSO<sub>4</sub> solution."

#: simcontrols.js:109
msgid ""
"No change is observed. This indicates that Fe is less reactive </br>than Al "
"so it cannot displace Al from Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</sub> "
"solution."
msgstr ""
"No change is observed. This indicates that Fe is less reactive </br>than Al "
"so it cannot displace Al from Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</sub> "
"solution."

#: simcontrols.js:112
msgid ""
"No change is observed. This indicates that Cu is less reactive </br>than Zn "
"so it cannot displace Zn from ZnSO<sub>4</sub> solution."
msgstr ""
"No change is observed. This indicates that Cu is less reactive </br>than Zn "
"so it cannot displace Zn from ZnSO<sub>4</sub> solution."

#: simcontrols.js:112
msgid ""
"No change is observed. This indicates that Cu is less reactive </br>than Al "
"so it cannot displace Al from from Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</"
"sub> solution."
msgstr ""
"No change is observed. This indicates that Cu is less reactive </br>than Al "
"so it cannot displace Al from from Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</"
"sub> solution."

#: simcontrols.js:112
msgid ""
"No change is observed. This indicates that Cu is less reactive </br>than Fe "
"so it cannot displace Fe from FeSO<sub>4</sub> solution."
msgstr ""
"No change is observed. This indicates that Cu is less reactive </br>than Fe "
"so it cannot displace Fe from FeSO<sub>4</sub> solution."

