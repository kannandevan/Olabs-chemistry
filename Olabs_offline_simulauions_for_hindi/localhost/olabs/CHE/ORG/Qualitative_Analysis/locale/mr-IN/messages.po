#: simcontrols_main.js:44
msgid "Identification of Anions"
msgstr "ऋण आयन ओळखणे"

#: simcontrols_main.js:51
msgid "Reset"
msgstr "पूर्ववत करा."

#: simcontrols_main.js:52 simcontrols_main.js:58
msgid "Drag the original salt towards the watch glass<br>to put it into the watch glass."
msgstr "वॉच ग्लास मध्ये मूळ क्षार टाकायला क्षार वॉच ग्लास कडे ओढा"

#: simcontrols_main.js:52
msgid "Drag the dropper towards the watch glass<br>to drop water into the sample."
msgstr "नमुन्यात पाणी टाकण्यासाठी ड्रॉपर वॉच ग्लास कडे ओढा."

#: simcontrols_main.js:52
msgid "Drag the hand towards the watch glass to rub<br>the pre-wetted salt with the fingers."
msgstr "आधीच ओले केलेले क्षार बोटाने मळण्यासाठी हात वॉच ग्लास कडे ओढा."

#: simcontrols_main.js:53 simcontrols_main.js:56
msgid "Drag the original salt towards the test tube to<br>put it into the test tube."
msgstr "परिक्षा नळीत मूळ क्षार टाकायला क्षार वॉच नळी कडे ओढा."

#: simcontrols_main.js:53
msgid ""
"Drag the dropper towards the test tube to<br>drop dil. H<sub>2</sub>SO<sub>4</sub> into the test tube."
msgstr "विरल H2SO4 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:53 simcontrols_main.js:62 simcontrols_main.js:123
msgid "Click on the knob of the burner to turn it on. "
msgstr "बर्नर सुरू करण्यासाठी बटण क्लिक करा."

#: simcontrols_main.js:53
msgid ""
"Again drag the dropper towards the test tube to<br>drop dil. H<sub>2</sub>SO<sub>4</sub> into the test "
"tube."
msgstr "परत विरल H2SO4 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:53 simcontrols_main.js:54
msgid "Drag the dropper towards the test tube to drop potassium<br>permanganate solution into the test tube."
msgstr "पोटाशियम परमॅंगनेट द्रावण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:54 simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop<br>salt solution into the test tube."
msgstr "क्षार द्रावण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:54
msgid "Drag the dropper towards the test tube to drop<br>dil. HNO<sub>3</sub> into the test tube."
msgstr "विरल HNO3 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:54 simcontrols_main.js:55 simcontrols_main.js:56 simcontrols_main.js:59
#: simcontrols_main.js:60 simcontrols_main.js:63 simcontrols_main.js:82
msgid "Click on the knob of the burner to turn it on."
msgstr "बर्नर सुरू करण्यासाठी बटण क्लिक करा."

#: simcontrols_main.js:54
msgid "Drag the dropper towards the test tube to drop<br>silver nitrate solution into the test tube."
msgstr "सिल्वर नायट्रेट परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:55 simcontrols_main.js:59
msgid "Drag the original salt towards the test tube<br>to put it into the test tube."
msgstr "परिक्षा नळीत मूळ क्षार टाकायला क्षार वॉच नळी कडे ओढा"

#: simcontrols_main.js:55
msgid "Drag manganese dioxide towards the test tube<br>to put it into the test tube."
msgstr "मॅंगनीस डायऑक्साइड परिक्षा नळीत टाकण्यासाठी मॅंगनीस डायऑक्साइड नळीकडे ओढा."

#: simcontrols_main.js:55 simcontrols_main.js:56
msgid ""
"Drag the dropper towards the test tube to drop<br>conc. H<sub>2</sub>SO<sub>4</sub> into the test tube."
msgstr "संहत H2SO4 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:55 simcontrols_main.js:235
msgid ""
"Drag the starch-iodide paper towards the test tube to show it<br>in the gas evolved from the test tube."
msgstr "स्टार्च-आयोडाइड कागद परिक्षा नळीकडे ओढा म्हणजे परिक्षा नळीतून येणार्याओ वायुशी संपर्कात येईल."

#: simcontrols_main.js:56
msgid "Drag the potassium dichromate powder towards the test tube to<br>put it into the test tube."
msgstr "पोटाशियम डायक्रोमेट परिक्षा नळीत टाकण्यासाठी पोटाशियम डायक्रोमेट नळीकडे ओढा."

#: simcontrols_main.js:56
msgid "Drag the cork towards the test tube to close<br>the test tube with it."
msgstr "परिक्षा नळी बंद करण्यासाठी बूच नळीकडे ओढा"

#: simcontrols_main.js:56
msgid "Drag the delivery tube towards the test tube to insert it<br>into the test tube through the cork."
msgstr "वितरण नलिका परिक्षा नळीकडे ओढा म्हणजे बूचातून नलिका आत जाईल."

#: simcontrols_main.js:56
msgid ""
"Drag the dropper towards the test tube to drop<br>dil. acetic acid (CH<sub>3</sub>COOH) into the test tube."
msgstr "विरल असेटिक आम्ल (CH3COOH) परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:56
msgid "Drag the dropper towards the test tube to drop lead acetate solution<br>into the test tube."
msgstr "लेड एसीटेट द्रावण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop dil.HCl<br>into the test tube."
msgstr "विरल HCl परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop<br>carbon disulphide into the test tube."
msgstr "कार्बन डायसल्फाइड परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop<br>chlorine water into the test tube."
msgstr "क्लोरिन वॉटर परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:57
msgid "Drag the test tube towards<br>the canvas area to shake it."
msgstr "परिक्षा नळी हलविण्यासाठी कॅन्वास क्षेत्राकडे ओढा."

#: simcontrols_main.js:58
msgid "Drag the watch glass towards the canvas area<br>to place it in the canvas area."
msgstr "वॉच ग्लास कॅन्वास क्षेत्रात ठेवण्यासाठी त्याला कॅन्वास क्षेत्राकडे ओढा."

#: simcontrols_main.js:58
msgid "Drag the oxalic acid crystals towards the watch glass<br>to put it into watch glass."
msgstr "ऑक्सेलिक आम्ल स्फटिके वॉच ग्लास मध्ये ठेवण्यासाठी त्यांना वॉच ग्लासकडे ओढा."

#: simcontrols_main.js:58
msgid ""
"Drag the bottle of distilled water towards the canvas area<br>and drag the dropper towards the watch glass "
"to<br>drop distilled water into the mixture."
msgstr "ऊर्ध्वपतित पाण्याची बाटली कॅन्वास क्षेत्राकडे ओढा आणि ऊर्ध्वपतित पाणी मिश्रणात टाकण्यासाठी ड्रॉपर वॉच ग्लास कडे ओढा."

#: simcontrols_main.js:58
msgid "Drag the hand towards the watch glass to rub<br>the pre-wetted mixture with the fingers."
msgstr "आधीच ओले केलेले क्षार बोटाने मळण्यासाठी हात वॉच ग्लास कडे ओढा."

#: simcontrols_main.js:59
msgid ""
"Drag the bottle of conc.H<sub>2</sub>SO<sub>4</sub> towards the canvas area<br>and drag the dropper "
"towards the test tube to<br>drop conc. H<sub>2</sub>SO<sub>4</sub> into the salt. "
msgstr "संहत H2SO4 ची बाटली कॅन्वास क्षेत्राकडे ओढा आणि संहत H2SO4 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:59
msgid ""
"Drag the bottle of ethyl alcohol towards the canvas area<br>and drag the dropper towards the test tube to "
"drop ethyl alcohol<br>into the test tube."
msgstr "इथाइल अल्कोहोलची बाटली कॅन्वास क्षेत्राकडे ओढा आणि इथाइल अल्कोहोल परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:59
msgid "Drag the beaker containing water near the burner<br>to place it in canvas area."
msgstr "बर्नर जवळचे पाणी असलेले चंचुपात्र कॅन्वास क्षेत्राकडे ओढा. "

#: simcontrols_main.js:59
msgid ""
"Click on the test tube and drag it towards the canvas area<br>to shake it well and pour the contents "
"into<br>beaker containing water."
msgstr "परिक्षा नळी नीट हलविण्यासाठी आणि त्यातले द्रावण चंचुपात्रात टाकण्यासाठी नळी कॅन्वास क्षेत्राकडे ओढा"

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the first test tube placed<br>in the test tube rack to drop the salt solution<br> "
"into the test tube."
msgstr "क्षार द्रावण रॅक वरच्या पहिल्या परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:60
msgid "Drag the dropper towards the test tube to drop ferric chloride<br>solution into the salt solution."
msgstr "क्षार द्रावण असलेल्या परिक्षा नळीत फेरिक क्लोराइड द्रावण टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:60
msgid ""
"Drag the filter funnel towards the second test tube in the test tube<br>rack to place it over the mouth of "
"the test tube."
msgstr "रॅक मधल्या दुसर्या् परिक्षा नळीच्या तोंडाशी फिल्टर नरसाळे ठेवण्यासाठी नरसाळे नळीकडे ओढा."

#: simcontrols_main.js:60
msgid ""
"Drag the test tube towards the funnel to filter the contents<br>into the second test tube through the "
"funnel."
msgstr "फिल्टर कागद असलेले नरसाळे वापरून दुसर्याय परिक्षा नळीत गळण एकत्र करण्यासाठी नळी नरसाळ्याकडे ओढा."

#: simcontrols_main.js:60
msgid ""
"Drag the test tube towards the stand to pour half of the reddish<br>coloured filtrate into the test tube "
"fixed to the stand."
msgstr "लाल रंगाच्या गळणातले अर्धे गळण स्टँड वरच्या दुसर्याप परिक्षा नळीत टाकण्यासाठी नळी स्टँडकडे ओढा."

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the stand to drop water into<br>the test tube containing reddish coloured "
"filtrate. "
msgstr "लाल गळण असलेल्या परिक्षा नळीत पाणी टाकण्यासाठी ड्रॉपर स्टँडकडे ओढा."

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the test tube in the test tube rack to<br>drop dil. HCl in to the reddish "
"coloured filtrate."
msgstr "लाल गळण असलेल्या परिक्षा नळीत विरल HCl टाकण्यासाठी ड्रॉपर स्टँड मधल्या नळीकडे ओढा."

#: simcontrols_main.js:61
msgid "Drag the original salt towards the stand to put it<br>into the test tube, fixed to the stand."
msgstr "स्टँडला लावलेल्या परिक्षा नळीत मूळ क्षार टाकायला, क्षार नळी कडे ओढा"

#: simcontrols_main.js:61
msgid "Drag the dropper towards the test tube to drop conc. H<sub>2</sub>SO<sub>4</sub><br>into the salt."
msgstr "क्षार असलेल्या परिक्षा नळीत संहत H2SO4 टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:61
msgid ""
"If colourless gas with pungent smell is evolved, drag<br>the glass rod towards the bottle containing "
"aqueous ammonia to dip<br>it in ammonia solution and again drag it towards the test tube<br>to show it in "
"the colourless gas. "
msgstr ""
"जर तिखट वास असलेली रंगहीन वायू निर्माण झाली तर काचेचा रॉड जलयुक्त अमोनिया असलेल्या बाटलीकडे ओढा म्हणजे त्यात ती बुडविल्या "
"जाईल, आणि मग रॉड परत नळी कडे ओढा म्हणजे तो वायू च्या संपर्कात येईल."

#: simcontrols_main.js:61
msgid ""
"If reddish brown gas with pungent smell is evolved,<br>drag the starch paper towards the tests tube "
"to<br>show it in the reddish brown gas."
msgstr "जर तिखट वास असलेली लाल-तपकिरी वायू निर्माण झाली तर स्टार्च कागद नळी कडे ओढा म्हणजे तो वायू च्या संपर्कात येईल."

#: simcontrols_main.js:61
msgid ""
"If deep violet vapours with pungent smell is evolevd,<br>drag the starch paper towards the tests tube to "
"show it<br>in the violet vapours."
msgstr "जर तिखट वास असलेली गडद जांभळी वायू निर्माण झाली तर स्टार्च कागद नळी कडे ओढा म्हणजे तो वायू च्या संपर्कात येईल."

#: simcontrols_main.js:61
msgid ""
"If colourless gas is evolved, drag the cork towards the stand<br>to close the test tube fixed to the stand "
"with it."
msgstr "जर रंगहीन वायु निर्माण झाली तर परिक्षा नळी बंद करण्यासाठी बूच स्टँडकडे ओढा."

#: simcontrols_main.js:61
msgid "Drag the delivery tube towards the stand to insert it<br>into the test tube through the cork."
msgstr "वितरण नलिका परिक्षा नळीकडे ओढा म्हणजे बूचातून नलिका आत जाईल."

#: simcontrols_main.js:62
msgid "Drag the dropper towards the test tube to drop salt<br>solution into the test tube."
msgstr "क्षार द्रावण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:62
msgid ""
"Drag the dropper towards the test tube to<br>drop acetic acid (C<sub>2</sub>H<sub>4</sub>O<sub>2</sub>) "
"into the test tube."
msgstr "असेटिक आम्ल (C2H4O2) परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:62
msgid "Drag the dropper towards the test tube to drop<br>calcium chloride solution into the test tube."
msgstr "कॅल्शियम क्लोराइड द्रावण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:62
msgid "Drag the dropper towards the test tube to drop<br>dil.HNO<sub>3</sub> into the test tube."
msgstr "विरल HNO3 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:63
msgid "Drag the original salt towards the test tube to<br>put it into test tube."
msgstr "परिक्षा नळीत मूळ क्षार टाकायला क्षार नळी कडे ओढा"

#: simcontrols_main.js:63
msgid "Drag the dropper towards the test tube to drop<br>dil. H<sub>2</sub>SO<sub>4 into the test tube."
msgstr "विरल H2SO4 परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:63
msgid ""
"Drag the dropper towards the test tube to drop potassium permanganate<br> solution into the test tube."
msgstr "पोटाशियम परमॅंगनेट परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:64
msgid "Drag the dropper towards the test tube <br>to drop salt solution into test tube."
msgstr "क्षार द्रावण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:64
msgid "Drag the dropper towards the test tube <br>to drop magnesia mixture into test tube."
msgstr "मॅग्नेशिया मिश्रण परिक्षा नळीत टाकण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols_main.js:65
msgid "Physical Examination"
msgstr "भौतिक परिक्षा"

#: simcontrols_main.js:65
