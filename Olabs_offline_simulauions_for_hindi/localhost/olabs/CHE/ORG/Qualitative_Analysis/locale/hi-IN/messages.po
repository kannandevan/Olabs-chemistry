#: simcontrols_main.js:44
msgid "Identification of Anions"
msgstr "ऋणायनों की पहचान"

#: simcontrols_main.js:51
msgid "Reset"
msgstr "रीसेट करें"

#: simcontrols_main.js:52 simcontrols_main.js:58
msgid "Drag the original salt towards the watch glass<br>to put it into the watch glass."
msgstr "वॉच ग्लास में डालने के लिए वॉच ग्लास की ओर मूल लवण खींचें ।"

#: simcontrols_main.js:52
msgid "Drag the dropper towards the watch glass<br>to drop water into the sample."
msgstr "नमूने में पानी डालने के लिए वॉच ग्लास की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:52
msgid "Drag the hand towards the watch glass to rub<br>the pre-wetted salt with the fingers."
msgstr "पहले से गीला लवण उंगलियों से रगड़ने के लिए वॉच ग्लास की ओर हाथ खींचें।"

#: simcontrols_main.js:53 simcontrols_main.js:56
msgid "Drag the original salt towards the test tube to<br>put it into the test tube."
msgstr "परखनली में डालने के लिए परखनली की ओर मूल लवण खींचें ।"

#: simcontrols_main.js:53
msgid ""
"Drag the dropper towards the test tube to<br>drop dil. H<sub>2</sub>SO<sub>4</sub> into the "
"test tube."
msgstr "परखनली में तनु H2SO4 डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:53 simcontrols_main.js:62 simcontrols_main.js:123
msgid "Click on the knob of the burner to turn it on. "
msgstr "चालू करने के लिए बर्नर की घुंडी पर क्लिक करें।"

#: simcontrols_main.js:53
msgid ""
"Again drag the dropper towards the test tube to<br>drop dil. H<sub>2</sub>SO<sub>4</sub> into "
"the test tube."
msgstr "फिर से परखनली में तनु H2SO4 डालने के लिए परखनली की ओर ड्रॉपर खींचें। ।"

#: simcontrols_main.js:53 simcontrols_main.js:54
msgid ""
"Drag the dropper towards the test tube to drop potassium<br>permanganate solution into the "
"test tube."
msgstr "परखनली में पोटेशियम परमैंगनेट का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:54 simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop<br>salt solution into the test tube."
msgstr "परखनली में लवण का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:54
msgid ""
"Drag the dropper towards the test tube to drop<br>dil. HNO<sub>3</sub> into the test tube."
msgstr "परखनली में तनु HNO3 डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:54 simcontrols_main.js:55 simcontrols_main.js:56 simcontrols_main.js:59
#: simcontrols_main.js:60 simcontrols_main.js:63 simcontrols_main.js:82
msgid "Click on the knob of the burner to turn it on."
msgstr "चालू करने के लिए बर्नर की घुंडी पर क्लिक करें।"

#: simcontrols_main.js:54
msgid ""
"Drag the dropper towards the test tube to drop<br>silver nitrate solution into the test tube."
msgstr "परखनली में सिल्वर नाइट्रेट का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:55 simcontrols_main.js:59
msgid "Drag the original salt towards the test tube<br>to put it into the test tube."
msgstr "परखनली में डालने के लिए परखनली की ओर मूल लवण खींचें ।"

#: simcontrols_main.js:55
msgid "Drag manganese dioxide towards the test tube<br>to put it into the test tube."
msgstr "परखनली में डालने के लिए परखनली की ओर मैंगनीज डाइऑक्साइड खींचें ।"

#: simcontrols_main.js:55 simcontrols_main.js:56
msgid ""
"Drag the dropper towards the test tube to drop<br>conc. H<sub>2</sub>SO<sub>4</sub> into the "
"test tube."
msgstr "परखनली में सांद्र H2SO4 डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:55 simcontrols_main.js:235
msgid ""
"Drag the starch-iodide paper towards the test tube to show it<br>in the gas evolved from the "
"test tube."
msgstr "परखनली से उत्पन्न गैस में दिखाने के लिए परखनली की ओर स्टार्च आयोडाइड पेपर खींचें"

#: simcontrols_main.js:56
msgid ""
"Drag the potassium dichromate powder towards the test tube to<br>put it into the test tube."
msgstr "परखनली में डालने के लिए परखनली की ओर पोटेशियम डाइक्रोमेट का पाउडर खींचें।"

#: simcontrols_main.js:56
msgid "Drag the cork towards the test tube to close<br>the test tube with it."
msgstr "परखनली बंद करने के लिए परखनली की ओर कार्क खींचें।"

#: simcontrols_main.js:56
msgid ""
"Drag the delivery tube towards the test tube to insert it<br>into the test tube through the "
"cork."
msgstr "कार्क के माध्यम से परखनली में डालने के लिए परखनली की ओर से डिलीवरी ट्यूब खींचें"

#: simcontrols_main.js:56
msgid ""
"Drag the dropper towards the test tube to drop<br>dil. acetic acid (CH<sub>3</sub>COOH) into "
"the test tube."
msgstr "परखनली में तनु एसिटिक अम्ल (CH3COOH) डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:56
msgid ""
"Drag the dropper towards the test tube to drop lead acetate solution<br>into the test tube."
msgstr "परखनली में लेड एसीटेट का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop dil.HCl<br>into the test tube."
msgstr "परखनली में तनु HCl डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop<br>carbon disulphide into the test tube."
msgstr "परखनली में कार्बन डाइसल्फाइड डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:57
msgid "Drag the dropper towards the test tube to drop<br>chlorine water into the test tube."
msgstr "परखनली में क्लोरीन जल डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:57
msgid "Drag the test tube towards<br>the canvas area to shake it."
msgstr "हिलाने के लिए कैनवास क्षेत्र की ओर परखनली खींचें।"

#: simcontrols_main.js:58
msgid "Drag the watch glass towards the canvas area<br>to place it in the canvas area."
msgstr "कैनवास क्षेत्र में रखने के लिए कैनवास क्षेत्र की ओर वॉच ग्लास खींचें ।"

#: simcontrols_main.js:58
msgid "Drag the oxalic acid crystals towards the watch glass<br>to put it into watch glass."
msgstr "वॉच ग्ला्स में डालने के लिए वॉच ग्ला्स की ओर आक्जेलिक अम्ल के क्रिस्टल खींचें ।"

#: simcontrols_main.js:58
msgid ""
"Drag the bottle of distilled water towards the canvas area<br>and drag the dropper towards "
"the watch glass to<br>drop distilled water into the mixture."
msgstr ""
"कैनवास क्षेत्र की ओर आसुत जल की बोतल खींचें और मिश्रण में आसुत जल डालने के लिए वॉच ग्ला्स की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:58
msgid "Drag the hand towards the watch glass to rub<br>the pre-wetted mixture with the fingers."
msgstr "गीला मिश्रण उंगलियों से रगड़ने के लिए वॉच ग्ला्स की ओर हाथ खींचें।"

#: simcontrols_main.js:59
msgid ""
"Drag the bottle of conc.H<sub>2</sub>SO<sub>4</sub> towards the canvas area<br>and drag the "
"dropper towards the test tube to<br>drop conc. H<sub>2</sub>SO<sub>4</sub> into the salt. "
msgstr ""
"कैनवास क्षेत्र की ओर सांद्र H2SO4 की बोतल खींचें और लवण में सांद्र H2SO4 डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:59
msgid ""
"Drag the bottle of ethyl alcohol towards the canvas area<br>and drag the dropper towards the "
"test tube to drop ethyl alcohol<br>into the test tube."
msgstr ""
"कैनवास क्षेत्र की ओर इथाइल अल्कोहल की बोतल खींचें और परखनली में इथाइल अल्कोहल  डालने के लिए परखनली की ओर "
"ड्रॉपर खींचें।"

#: simcontrols_main.js:59
msgid "Drag the beaker containing water near the burner<br>to place it in canvas area."
msgstr "कैनवास क्षेत्र में रखने के लिए बर्नर के पास जल युक्त बीकर खींचें।"

#: simcontrols_main.js:59
msgid ""
"Click on the test tube and drag it towards the canvas area<br>to shake it well and pour the "
"contents into<br>beaker containing water."
msgstr ""
"परखनली पर क्लिक करें और अच्छी तरह से हिलाने के लिए और जल युक्त बीकर में सामग्री डालने के लिए इसे कैनवास क्षेत्र "
"की ओर खींचें ।"

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the first test tube placed<br>in the test tube rack to drop the salt "
"solution<br> into the test tube."
msgstr "परखनली में लवण का विलयन डालने के लिए परखनली रैक में रखी पहली परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the test tube to drop ferric chloride<br>solution into the salt "
"solution."
msgstr "लवण के विलयन में फेरिक क्लोराइड का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:60
msgid ""
"Drag the filter funnel towards the second test tube in the test tube<br>rack to place it over "
"the mouth of the test tube."
msgstr "परखनली के मुंह पर रखने के लिए परखनली रैक में दूसरी परखनली की ओर फिल्टर कीप खींचें ।"

#: simcontrols_main.js:60
msgid ""
"Drag the test tube towards the funnel to filter the contents<br>into the second test tube "
"through the funnel."
msgstr "कीप के माध्यम से दूसरी परखनली में सामग्री छानने के लिए कीप की ओर परखनली खींचें"

#: simcontrols_main.js:60
msgid ""
"Drag the test tube towards the stand to pour half of the reddish<br>coloured filtrate into "
"the test tube fixed to the stand."
msgstr "स्टै्ण्ड में लगी परखनली में लाल रंग की छनी हुई आधी सामग्री डालने के लिए स्टैंड की ओर परखनली खींचें।"

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the stand to drop water into<br>the test tube containing reddish "
"coloured filtrate. "
msgstr "लाल रंग की छनी हुई सामग्री युक्त परखनली में पानी डालने के लिए स्टैंड की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:60
msgid ""
"Drag the dropper towards the test tube in the test tube rack to<br>drop dil. HCl in to the "
"reddish coloured filtrate."
msgstr "लाल रंग की छनी हुई सामग्री में तनु HCl डालने के लिए परखनली रैक में परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:61
msgid ""
"Drag the original salt towards the stand to put it<br>into the test tube, fixed to the stand."
msgstr "स्टैण्ड से लगी परखनली में डालने के लिए स्टैंड की ओर मूल लवण खींचें।"

#: simcontrols_main.js:61
msgid ""
"Drag the dropper towards the test tube to drop conc. H<sub>2</sub>SO<sub>4</sub><br>into the "
"salt."
msgstr "लवण में सांद्र H2SO4 डालने के लिए परखनली की ओर ड्रॉपर खींचें।"

#: simcontrols_main.js:61
msgid ""
"If colourless gas with pungent smell is evolved, drag<br>the glass rod towards the bottle "
"containing aqueous ammonia to dip<br>it in ammonia solution and again drag it towards the "
"test tube<br>to show it in the colourless gas. "
msgstr ""
"यदि तीखी गंध वाली रंगहीन गैस उत्पन्न होती है, तो अमोनिया के विलयन में डुबोने के लिए जलीय अमोनिया युक्त बोतल "
"की ओर कांच की छड़ खींचें और इसे फिर से रंगहीन गैस में दिखाने के लिए परखनली की ओर खींचें।"

#: simcontrols_main.js:61
msgid ""
"If reddish brown gas with pungent smell is evolved,<br>drag the starch paper towards the "
"tests tube to<br>show it in the reddish brown gas."
msgstr ""
"यदि तीखी गंध वाली लाल भूरे रंग की गैस उत्पन्न होती है, तो लाल भूरे रंग की गैस में दिखाने के लिए परखनली की ओर "
"स्टार्च पेपर खींचें।"

#: simcontrols_main.js:61
msgid ""
"If deep violet vapours with pungent smell is evolevd,<br>drag the starch paper towards the "
"tests tube to show it<br>in the violet vapours."
msgstr ""
"यदि तीखी गंध वाली बैंगनी वाष्प उत्पन्न होती है, तो बैंगनी वाष्प में दिखाने के लिए परखनली की ओर स्टार्च पेपर "
"खींचें।"

#: simcontrols_main.js:61
msgid ""
"If colourless gas is evolved, drag the cork towards the stand<br>to close the test tube fixed "
"to the stand with it."
msgstr "यदि रंगहीन गैस उत्पन्न होती है,  तो स्टैण्ड से लगी परखनली बंद करने के लिए स्टैंड की ओर कार्क खींचें।"

#: simcontrols_main.js:61
msgid ""
"Drag the delivery tube towards the stand to insert it<br>into the test tube through the cork."
msgstr "कार्क के माध्यम से परखनली में डालने के लिए स्टैंड की ओर डिलीवरी ट्यूब खींचें।"

#: simcontrols_main.js:62
msgid "Drag the dropper towards the test tube to drop salt<br>solution into the test tube."
msgstr "परखनली में लवण का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:62
msgid ""
"Drag the dropper towards the test tube to<br>drop acetic acid (C<sub>2</sub>H<sub>4</"
"sub>O<sub>2</sub>) into the test tube."
msgstr "परखनली में एसिटिक अम्ले (C2H4O2) डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:62
msgid ""
"Drag the dropper towards the test tube to drop<br>calcium chloride solution into the test "
"tube."
msgstr "परखनली में कैल्शियम क्लोराइड का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:62
msgid ""
"Drag the dropper towards the test tube to drop<br>dil.HNO<sub>3</sub> into the test tube."
msgstr "परखनली में तनु HNO3 डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:63
msgid "Drag the original salt towards the test tube to<br>put it into test tube."
msgstr "परखनली में डालने के लिए परखनली की ओर मूल लवण खींचें।"

#: simcontrols_main.js:63
msgid ""
"Drag the dropper towards the test tube to drop<br>dil. H<sub>2</sub>SO<sub>4 into the test "
"tube."
msgstr "परखनली में तनु H2SO4 डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:63
msgid ""
"Drag the dropper towards the test tube to drop potassium permanganate<br> solution into the "
"test tube."
msgstr "परखनली में पोटेशियम परमैंगनेट का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें"

#: simcontrols_main.js:64
msgid "Drag the dropper towards the test tube <br>to drop salt solution into test tube."
msgstr "परखनली में लवण का विलयन डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:64
msgid "Drag the dropper towards the test tube <br>to drop magnesia mixture into test tube."
msgstr "परखनली में मैग्नीशिया मिश्रण डालने के लिए परखनली की ओर ड्रॉपर खींचें ।"

#: simcontrols_main.js:65
msgid "Physical Examination"
msgstr "भौतिक परीक्षण"

#: simcontrols_main.js:65
msgid "Dry Heating Test"
msgstr "शुष्क उष्मन परीक्षण"

#: simcontrols_main.js:65
msgid "Dilute Sulphuric Acid Test"
msgstr "तनु सल्फ्यूरिक अम्ल परीक्षण"

#: simcontrols_main.js:65 simcontrols_main.js:68 simcontrols_main.js:145
msgid "Potassium permanganate test"
msgstr "पोटेशियम परमैंगनेट परीक्षण"

#: simcontrols_main.js:65
msgid "Concentrated Sulphuric Acid Test"
msgstr "सांद्रित सल्फ्यूरिक अम्ल परीक्षण"

#: simcontrols_main.js:65
msgid "Independent Group Test"
msgstr "स्वतंत्र समूह परीक्षण"

#: simcontrols_main.js:66
msgid "--Select--"
msgstr "--चुनें-"

#: simcontrols_main.js:66
msgid "Carbonate"
msgstr "कार्बोनेट"

#: simcontrols_main.js:66
msgid "Sulphite"
msgstr "सल्फाइट"

#: simcontrols_main.js:66
msgid "Sulphide"
msgstr "सल्फाइड"

#: simcontrols_main.js:66
msgid "Nitrite"
msgstr "नाइट्राइट"

#: simcontrols_main.js:66
msgid "Nitrate"
