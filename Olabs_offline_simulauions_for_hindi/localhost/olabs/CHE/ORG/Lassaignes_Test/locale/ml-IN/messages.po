msgstr "ലാസ്സൈൻസ് മിശ്രിതം"

#: simcontrols.js:36
msgid "Sodium nitroprusside"
msgstr "സോഡിയം നൈട്രോപ്രുസൈഡ് "

#: simcontrols.js:36
msgid "Acetic acid"
msgstr "അസറ്റിക് ആസിഡ്"

#: simcontrols.js:36
msgid "Lead acetate"
msgstr "ലെഡ് അസറ്റേറ്റ്"

#: simcontrols.js:36
msgid "FeSO<sub>4</sub> solution"
msgstr "FeSO<sub>4</sub>ലായനി"

#: simcontrols.js:36
