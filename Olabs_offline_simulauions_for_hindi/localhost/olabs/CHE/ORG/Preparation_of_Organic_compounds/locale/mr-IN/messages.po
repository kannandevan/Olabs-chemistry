msgstr "एनिलीन + HCl + पाणी "

#: simcontrols.js:64
msgid "Aniline + HCl + Sodium nitrite"
msgstr "एनिलीन + HCl + सोडियम नायट्राइट "

#: simcontrols.js:65
msgid "Alkaline 2Naphthol"
msgstr "अल्कधर्मी २-नाफ्थोल"

#: simcontrols.js:66
msgid "Hot solution of 2Naphthol aniline Dye"
msgstr "२-नाफ्थोल एनिलीन डाय गरम द्रावण"

#: simcontrols.js:67
msgid "Crystals of 2Naphthol aniline Dye"
msgstr "२-नाफ्थोल एनिलीन डायची स्फटिके "

#: simcontrols.js:69
msgid "Drag the measuring jar to the RB flask to pour glacial acetic acid into acetic anhydride."
msgstr "असेटीक अॅन्हायड्राइड मध्ये ग्लेशियल असेटीक आम्ल टाकण्यासाठी मापन जार आरबी चंबू कडे ओढा."

#: simcontrols.js:69
msgid "Drag the measuring jar to the RB flask to pour aniline into it."
msgstr "एनिलीन टाकण्यासाठी मापन जार आरबी चंबू कडे ओढा."

#: simcontrols.js:69
msgid "Drag the RB flask to the trough to place it in water."
msgstr "आरबी चंबू पाण्यात ठेवण्यासाठी कुंडाकडे ओढा"

#: simcontrols.js:69
msgid "Drag the RB flask to the beaker to pour the contents into ice cold water."
msgstr "आरबी चंबूतले द्रावण बर्फाच्या पाण्यात टाकण्यासाठी चंबू चंचुपात्राकडे ओढा."

#: simcontrols.js:69
msgid "Drag the beaker to the Buchner funnel to filter the precipitate of acetanilide."
msgstr "एसेटानिलाइड चे अवक्षेपण गाळण्यासाठी चंचुपात्र बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:69
msgid "Drag the bottle to the Buchner funnel to wash the precipitate with water."
msgstr "अवक्षेपण पाण्याने धुण्यासाठी बाटली बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:69
msgid ""
"Drag the beaker to the beaker containing precipitate of acetanilide to pour acetic acid water mixture into it."
msgstr "एसेटानिलाइड चे अवक्षेपण असलेल्या चंचुपात्रात असेटीक आम्ल-पाणी मिश्रण टाकण्यासाठी  चंचुपात्र त्याच्याकडे ओढा."

#: simcontrols.js:69
msgid "Drag the beaker to the burner to heat the contents."
msgstr "चंचुपात्रातले द्रावण गरम करण्यासाठी चंचुपात्र बर्नरकडे ओढा."

#: simcontrols.js:69
msgid "Drag the beaker to the funnel to filter the hot solution into the conical flask."
msgstr "गरम द्रावण शंक्वाकृती चंबूत गाळण्यासाठी चंचुपात्र बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:69
msgid "Drag the conical flask to the ice bath to cool its contents."
msgstr "शंक्वाकृती चंबू बर्फाच्या थंड करण्यासाठी चंबू कुंडाकडे ओढा."

#: simcontrols.js:69
msgid "Drag the conical flask to the Buchner funnel to filter the crystals of acetanilide."
msgstr "एसेटानिलाइडची स्फटिके गाळण्यासाठी शंक्वाकृती चंबू बुक्नर नरसाळ्याकडे ओढा"

#: simcontrols.js:69
msgid "Click and drag the spatula to the Buchner funnel to transfer the crystals to the filter paper."
msgstr "स्फटिके फिल्टर कागदावर घेण्यासाठी स्पाट्युला बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:70
msgid "Drag the RB flask to shake it."
msgstr "आरबी चंबू हलविण्यासाठी त्याला ओढा."

#: simcontrols.js:71
msgid "Click on the knob of the burner to turn it on."
msgstr "बर्नर सुरू करण्यासाठी बटण क्लिक करा."

#: simcontrols.js:72
msgid "Drag the conical flask to shake it."
msgstr "शंक्वाकृती चंबू हलविण्यासाठी त्याला ओढा."

#: simcontrols.js:73
msgid "White shining flakes of acetanilide are obtained."
msgstr "एसेटानिलाइड चे पांढरे चमकणारे तुकडे दिसतील."

#: simcontrols.js:74
msgid ""
"Drag the measuring jar to the conical flask to pour rectified spirit into the mixture of acetone and "
"benzaldehyde."
msgstr "अॅसिटोन आणि बेंझालडिहाइड च्या मिश्रणात परिशोधित स्पिरीट टाकण्यासाठी मापन जार शंक्वाकृती चंबूकडे ओढा."

#: simcontrols.js:74
msgid "Drag the dropper to the conical flask to add 5ml 10% NaOH solution into it."
msgstr "५ मिली १०% NaOH द्रावण शंक्वाकृती चंबूत टाकण्यासाठी ड्रॉपर चंबूकडे ओढा."

#: simcontrols.js:74
msgid "Drag the cork to close the conical flask."
msgstr "शंक्वाकृती चंबू बंद करण्यासाठी बूच चंबूकडे ओढा."

#: simcontrols.js:74
msgid "Drag the conical flask to the trough to place it in cold water."
msgstr "शंक्वाकृती चंबू थंड पाण्यात ठेवण्यासाठी चंबू कुंडाकडे ओढा."

#: simcontrols.js:74
msgid "Drag the conical flask to the Buchner funnel to filter the precipitate of dibenzal acetone."
msgstr "डायबेंझाल अॅसिटोनची स्फटिके गाळण्यासाठी शंक्वाकृती चंबू बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:74
msgid ""
"Drag the beaker to the beaker containing precipitate of dibenzal acetone to pour hot rectified spirit into it."
msgstr "डायबेंझाल अॅसिटोन चे अवक्षेपण असलेल्या चंचुपात्रात गरम परिशोधित स्पिरीट टाकण्यासाठी त्याच्याकडे चंचुपात्र ओढा."

#: simcontrols.js:74
msgid "Drag the beaker to the Buchner funnel to filter the crystals of dibenzal acetone."
msgstr "डायबेंझाल अॅसिटोनची स्फटिके गाळण्यासाठी चंचुपात्र बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:75
msgid "Pale yellow crystals of dibenzal acetone are obtained."
msgstr "डायबेंझाल अॅसिटोनची फिकट पिवळी स्फटिके निर्माण झालेली दिसतील."

#: simcontrols.js:76
msgid "Drag the measuring jar to the conical flask to pour glacial acetic acid into acetanilide."
msgstr "एसेटानिलाइड मध्ये ग्लेशियल असेटीक आम्ल टाकण्यासाठी मापन जार शंक्वाकृती चंबूकडे ओढा."

#: simcontrols.js:76
msgid "Drag the conical flask to the trough to place it in water."
msgstr "शंक्वाकृती चंबू पाण्यात ठेवण्यासाठी चंबू कुंडाकडे ओढा."

#: simcontrols.js:76
msgid "Drag the dropper to the conical flask to add conc. H2SO4 to it."
msgstr "संहत H2SO4 शंक्वाकृती चंबूत टाकण्यासाठी ड्रॉपर चंबूकडे ओढा."

#: simcontrols.js:76
msgid "Click on the glass rod to stir the contents of the conical flask."
msgstr "चंचुपात्रातले द्रावण ढवळण्यासाठी काचेच्या रॉड वर क्लिक करा."

#: simcontrols.js:76
msgid ""
"Drag the dropper to the freezing mixture to take the mixture of fuming nitric acid and conc. H2SO4 from the "
"test tube."
msgstr "अतिशीत मिश्रणात ठेवलेल्या परीक्षा नळीतून धूर येणारे नायट्रिक आम्ल आणि संहत H2SO4 घेण्यासाठी ड्रॉपर नळीकडे ओढा."

#: simcontrols.js:76
msgid "Drag the dropper to the conical flask to add the mixture of fuming nitric acid and conc. H2SO4 to it."
msgstr "धूर येणारे नायट्रिक आम्ल आणि संहत H2SO4 याचे मिश्रण शंक्वाकृती चंबूत टाकण्यासाठी ड्रॉपर चंबूकडे ओढा."

#: simcontrols.js:76
msgid "Drag the conical flask to leave it undisturbed for 30 minutes."
msgstr "शंक्वाकृती चंबू ३० मिनिटे तसेच राहू द्यायला त्याला ओढा."

#: simcontrols.js:76
msgid "Drag the conical flask to the beaker to pour the solution into crushed ice."
msgstr "द्रावण बर्फाच्या तुकड्यांवर टाकण्यासाठी शंक्वाकृती चंबू चंचुपात्राकडे ओढा."

#: simcontrols.js:76
msgid "Drag the beaker to the Buchner funnel to filter the precipitate of pnitroacetanilide."
msgstr "चंचुपात्रातले पी-नायट्रोएसेटानिलाइड गाळण्यासाठी चंचुपात्र बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:76
msgid ""
"Drag the beaker to the beaker containing precipitate of pnitroacetanilide to pour methylated spirit into it."
msgstr "पी-नायट्रोएसेटानिलाइड अवक्षेपण असलेल्या चंचुपात्रात मिथायलेटेड स्पिरीट टाकण्यासाठी त्याच्याकडे चंचुपात्र ओढा."

#: simcontrols.js:76
msgid "Drag the conical flask to the Buchner funnel to filter the crystals of pnitroacetanilide."
msgstr "पी-नायट्रोएसेटानिलाइड स्फटिके गाळण्यासाठी शंक्वाकृती चंबू बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:77
msgid "Colourless crystals of pnitroacetanilide are obtained."
msgstr "पी-नायट्रोएसेटानिलाइडची रंगहीन स्फटिके दिसतील."

#: simcontrols.js:78
msgid "Drag the measuring jar to the conical flask to add conc.HCl into aniline."
msgstr "एनिलीन असलेल्या शंक्वाकृती चंबूत संहत HCl टाकण्यासाठी मापन जार चंबूकडे ओढा."

#: simcontrols.js:78
msgid "Drag the measuring jar to the conical flask to pour water into it."
msgstr "शंक्वाकृती चंबूत पाणी टाकण्यासाठी मापन जार चंबूकडे ओढा."

#: simcontrols.js:78
msgid "Drag the conical flask to the ice bath to cool the contents."
msgstr "चंचुपात्रातले द्रावण थंड करण्यासाठी चंचुपात्र बर्फाच्या कुंडाकडे ओढा."

#: simcontrols.js:78
msgid "Drag the beaker to the beaker containing sodium nitrite to add water into it."
msgstr "सोडियम नायट्राइट असलेल्या चंचुपात्रात ऊर्ध्वपतित पाणी टाकण्यासाठी त्याच्याकडे चंचुपात्र ओढा."

#: simcontrols.js:78
msgid "Drag the beaker to the ice bath to cool the contents."
msgstr "चंचुपात्रातले द्रावण थंड करण्यासाठी चंचुपात्र बर्फाच्या कुंडाकडे ओढा."

#: simcontrols.js:78
msgid "Drag the beaker to the conical flask to add sodium nitrite solution to it."
msgstr "शंक्वाकृती चंबूत सोडियम नायट्राइट टाकण्यासाठी चंचुपात्र चंबूकडे ओढा."

#: simcontrols.js:78
msgid "Drag the beaker to the beaker containing 2- naphthol to add 10% NaOH into it."
msgstr "२-नाफ्थोल असलेल्या चंचुपात्रात १०% NaOH द्रावण टाकण्यासाठी त्याच्याकडे चंचुपात्र ओढा."

#: simcontrols.js:78
msgid ""
"Drag the conical flask to the beaker to add the mixture of aniline and sodium nitrite solution into the "
"beaker containing 2 naphthol solution."
msgstr ""
"एनिलीन आणि सोडियम नायट्राइट द्रावण ह्यांचे मिश्रण असलेल्या चंचुपात्रात २-नाफ्थोल द्रावण टाकण्यासाठी शंक्वाकृती चंबू चंचुपात्राकडे "
"ओढा."

#: simcontrols.js:78
msgid "Click on the glass rod to stir the contents of the beaker."
msgstr "चंचुपात्रातले द्रावण ढवळण्यासाठी काचेच्या रॉड वर क्लिक करा."

#: simcontrols.js:78
msgid "Drag the beaker to the Buchner funnel to filter the precipitate of 2naphthol aniline dye."
msgstr "२-नाफ्थोल एनिलीन डायचे अवक्षेपण गाळण्यासाठी चंचुपात्र बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:78
msgid ""
"Drag the beaker to the beaker containing precipitate of 2-naphthol aniline dye to add glacial acetic acid to "
"it."
msgstr "२-नाफ्थोल एनिलीन डाय असलेल्या चंचुपात्रात ४० मिली ग्लेशियल असेटीक आम्ल टाकण्यासाठी त्याच्याकडे चंचुपात्र ओढा."

#: simcontrols.js:78
msgid "Drag the conical flask to the Buchner funnel to filter the crystals of 2naphthol aniline dye."
msgstr "२-नाफ्थोल एनिलीन डाय स्फटिके गाळण्यासाठी शंक्वाकृती चंबू बुक्नर नरसाळ्याकडे ओढा."

#: simcontrols.js:79
msgid "Deep red crystals of 2-naphthol aniline dye are obtained."
msgstr "२-नाफ्थोल एनिलीन डायची गडद लाल स्फटिके निर्माण होतात."

#: simcontrols.js:80
msgid "8ml of conc. H2SO4 is added into the conical flask"
msgstr "८ मिली संहत H2SO4 शंक्वाकृती चंबूत टाका."

#: simcontrols.js:81
msgid "Acetanilide + Glacial acetic acid + Conc. H2SO4"
msgstr "एसेटानिलाइड + ग्लेशियल असेटीक आम्ल + संहत H2SO4"

#: simcontrols.js:82
msgid "Fuming HNO3 (2 ml) + Conc. H2SO4 (2 ml)"
msgstr "धूर येणारे HNO3 (२ मिली) + संहत H2SO4 (२ मिली)"

