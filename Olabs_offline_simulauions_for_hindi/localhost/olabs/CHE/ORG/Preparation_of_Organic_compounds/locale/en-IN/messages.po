#: simcontrols.js:69
msgid ""
"Drag the measuring jar to the RB flask to pour glacial acetic acid into "
"acetic anhydride."
msgstr ""
"Drag the measuring jar to the RB <br>flask to pour glacial acetic <br>acid "
"into acetic anhydride."

#: simcontrols.js:69
msgid "Drag the measuring jar to the RB flask to pour aniline into it."
msgstr "Drag the measuring jar to the RB <br>flask to pour aniline into it."

#: simcontrols.js:69
msgid "Drag the RB flask to the trough to place it in water."
msgstr "Drag the RB flask to the trough <br>to place it in water."

#: simcontrols.js:69
msgid ""
"Drag the RB flask to the beaker to pour the contents into ice cold water."
msgstr ""
"Drag the RB flask to the beaker to <br>pour the contents into ice cold water."

#: simcontrols.js:69
msgid ""
"Drag the beaker to the Buchner funnel to filter the precipitate of "
"acetanilide."
msgstr ""
"Drag the beaker to the Buchner <br>funnel to filter the precipitate<br> of "
"acetanilide."

#: simcontrols.js:69
msgid ""
"Drag the bottle to the Buchner funnel to wash the precipitate with water."
msgstr ""
"Drag the bottle to the Buchner <br>funnel to wash the precipitate <br>with "
"water."

#: simcontrols.js:69
msgid ""
"Drag the beaker to the beaker containing precipitate of acetanilide to pour "
"acetic acid water mixture into it."
msgstr ""
"Drag the beaker to the beaker <br>containing precipitate of <br>acetanilide "
"to pour acetic <br> acid water mixture into it."

#: simcontrols.js:69
msgid "Drag the beaker to the burner to heat the contents."
msgstr "Drag the beaker to the burner <br> to heat the contents."

#: simcontrols.js:69
msgid ""
"Drag the beaker to the funnel to filter the hot solution into the conical "
"flask."
msgstr ""
"Drag the beaker to the funnel to <br>filter the hot solution into the "
"<br>conical flask."

#: simcontrols.js:69
msgid "Drag the conical flask to the ice bath to cool its contents."
msgstr "Drag the conical flask to the ice <br>bath to cool its contents."

#: simcontrols.js:69
msgid ""
"Drag the conical flask to the Buchner funnel to filter the crystals of "
"acetanilide."
msgstr ""
"Drag the conical flask to the <br>Buchner funnel to filter the <br>crystals "
"of acetanilide."

#: simcontrols.js:69
msgid ""
"Click and drag the spatula to the Buchner funnel to transfer the crystals to "
"the filter paper."
msgstr ""
"Click and drag the spatula to the <br>Buchner funnel to transfer the "
"<br>crystals to the filter paper."

#: simcontrols.js:70
msgid "Drag the RB flask to shake it."
msgstr "Drag the RB flask to shake it."

#: simcontrols.js:71
msgid "Click on the knob of the burner to turn it on."
msgstr "Click on the knob of the burner to turn it on."

#: simcontrols.js:72
msgid "Drag the conical flask to shake it."
msgstr "Drag the conical flask to shake it."

#: simcontrols.js:73
msgid "White shining flakes of acetanilide are obtained."
msgstr "White shining flakes of acetanilide are obtained."

#: simcontrols.js:74
msgid ""
"Drag the measuring jar to the conical flask to pour rectified spirit into "
"the mixture of acetone and benzaldehyde."
msgstr ""
"Drag the measuring jar to the <br>conical flask to pour rectified <br>spirit "
"into the mixture of <br>acetone and benzaldehyde."

#: simcontrols.js:74
msgid ""
"Drag the dropper to the conical flask to add 5ml 10% NaOH solution into it."
msgstr ""
"Drag the dropper to the conical flask <br>to add 5ml 10% NaOH solution into "
"it."

#: simcontrols.js:74
msgid "Drag the cork to close the conical flask."
msgstr "Drag the cork to close the conical flask."

#: simcontrols.js:74
msgid "Drag the conical flask to the trough to place it in cold water."
msgstr "Drag the conical flask to the trough <br>to place it in cold water."

#: simcontrols.js:74
msgid ""
"Drag the conical flask to the Buchner funnel to filter the precipitate of "
"dibenzal acetone."
msgstr ""
"Drag the conical flask to the <br>Buchner funnel to filter the "
"<br>precipitate of dibenzal acetone."

#: simcontrols.js:74
msgid ""
"Drag the beaker to the beaker containing precipitate of dibenzal acetone to "
"pour hot rectified spirit into it."
msgstr ""
"Drag the beaker to the beaker <br>containing precipitate of <br>dibenzal "
"acetone to pour hot <br>rectified spirit into it."

#: simcontrols.js:74
msgid ""
"Drag the beaker to the Buchner funnel to filter the crystals of dibenzal "
"acetone."
msgstr ""
"Drag the beaker to the Buchner <br>funnel to filter the crystals <br>of "
"dibenzal acetone."

#: simcontrols.js:75
msgid "Pale yellow crystals of dibenzal acetone are obtained."
msgstr "Pale yellow crystals of dibenzal <br>acetone are obtained."

#: simcontrols.js:76
msgid ""
"Drag the measuring jar to the conical flask to pour glacial acetic acid into "
"acetanilide."
msgstr ""
"Drag the measuring jar to the <br>conical flask to pour glacial <br>acetic "
"acid into acetanilide."

#: simcontrols.js:76
msgid "Drag the conical flask to the trough to place it in water."
msgstr "Drag the conical flask to the trough <br>to place it in water."

#: simcontrols.js:76
msgid "Drag the dropper to the conical flask to add conc. H2SO4 to it."
msgstr ""
"Drag the dropper to the conical <br>flask to add conc. H<sub>2</"
"sub>SO<sub>4</sub> to it."

#: simcontrols.js:76
msgid "Click on the glass rod to stir the contents of the conical flask."
msgstr "Click on the glass rod to stir the <br>contents of the conical flask."

#: simcontrols.js:76
msgid ""
"Drag the dropper to the freezing mixture to take the mixture of fuming "
"nitric acid and conc. H2SO4 from the test tube."
msgstr ""
"Drag the dropper to the freezing <br>mixture to take the mixture of "
"<br>fuming nitric acid and conc. H<sub>2</sub>SO<sub>4</sub><br> from the "
"test tube."

#: simcontrols.js:76
msgid ""
"Drag the dropper to the conical flask to add the mixture of fuming nitric "
"acid and conc. H2SO4 to it."
msgstr ""
"Drag the dropper to the conical <br>flask to add the mixture of "
"fuming<br>nitric acid and conc. H<sub>2</sub>SO<sub>4</sub> to it."

#: simcontrols.js:76
msgid "Drag the conical flask to leave it undisturbed for 30 minutes."
msgstr ""
"Drag the conical flask to the table to<br> leave it undisturbed for 30 "
"minutes."

#: simcontrols.js:76
msgid ""
"Drag the conical flask to the beaker to pour the solution into crushed ice."
msgstr ""
"Drag the conical flask to the beaker <br>to pour the solution into crushed "
"ice."

#: simcontrols.js:76
msgid ""
"Drag the beaker to the Buchner funnel to filter the precipitate of "
"pnitroacetanilide."
msgstr ""
"Drag the beaker to the Buchner <br>funnel to filter the precipitate<br> of p-"
"nitroacetanilide."

#: simcontrols.js:76
msgid ""
"Drag the beaker to the beaker containing precipitate of pnitroacetanilide to "
"pour methylated spirit into it."
msgstr ""
"Drag the beaker to the beaker <br>containing precipitate of <br>p-"
"nitroacetanilide to pour<br> methylated spirit into it."

#: simcontrols.js:76
msgid ""
"Drag the conical flask to the Buchner funnel to filter the crystals of "
"pnitroacetanilide."
msgstr ""
"Drag the conical flask to the <br>Buchner funnel to filter the <br>crystals "
"of p-nitroacetanilide."

#: simcontrols.js:77
msgid "Colourless crystals of pnitroacetanilide are obtained."
msgstr "Colourless crystals of p-nitroacetanilide <br>are obtained."

#: simcontrols.js:78
msgid ""
"Drag the measuring jar to the conical flask to add conc.HCl into aniline."
msgstr ""
"Drag the measuring jar to the conical <br>flask to add conc.HCl into aniline."

#: simcontrols.js:78
msgid "Drag the measuring jar to the conical flask to pour water into it."
msgstr "Drag the measuring jar to the conical <br>flask to pour water into it."

#: simcontrols.js:78
msgid "Drag the conical flask to the ice bath to cool the contents."
msgstr "Drag the conical flask to the <br>ice bath to cool the contents."

#: simcontrols.js:78
msgid ""
"Drag the beaker to the beaker containing sodium nitrite to add water into it."
msgstr ""
"Drag the beaker to the beaker <br>containing sodium nitrite to <br>add water "
"into it."

#: simcontrols.js:78
msgid "Drag the beaker to the ice bath to cool the contents."
msgstr "Drag the beaker to the ice bath <br>to cool the contents."

#: simcontrols.js:78
msgid ""
"Drag the beaker to the conical flask to add sodium nitrite solution to it."
msgstr ""
"Drag the beaker to the conical <br>flask to add sodium nitrite <br>solution "
"to it."

#: simcontrols.js:78
msgid ""
"Drag the beaker to the beaker containing 2- naphthol to add 10% NaOH into it."
msgstr ""
"Drag the beaker to the beaker <br>containing 2- naphthol to add <br>10% NaOH "
"into it."

#: simcontrols.js:78
msgid ""
"Drag the conical flask to the beaker to add the mixture of aniline and "
"sodium nitrite solution into the beaker containing 2 naphthol solution."
msgstr ""
"Drag the conical flask to the beaker <br>to add the mixture of aniline and "
"<br>sodium nitrite solution into the <br>beaker containing 2-naphthol "
"solution."

#: simcontrols.js:78
msgid "Click on the glass rod to stir the contents of the beaker."
msgstr "Click on the glass rod to stir <br>the contents of the beaker."

#: simcontrols.js:78
msgid ""
"Drag the beaker to the Buchner funnel to filter the precipitate of 2naphthol "
"aniline dye."
msgstr ""
"Drag the beaker to the Buchner <br>funnel to filter the precipitate <br>of 2-"
"naphthol aniline dye."

#: simcontrols.js:78
msgid ""
"Drag the beaker to the beaker containing precipitate of 2-naphthol aniline "
"dye to add glacial acetic acid to it."
msgstr ""
"Drag the beaker to the beaker containing <br>precipitate of 2-naphthol "
"aniline dye <br>to add glacial acetic acid to it."

#: simcontrols.js:78
msgid ""
"Drag the conical flask to the Buchner funnel to filter the crystals of "
"2naphthol aniline dye."
msgstr ""
"Drag the conical flask to the Buchner <br>funnel to filter the crystals of "
"<br>2-naphthol aniline dye."

#: simcontrols.js:79
msgid "Deep red crystals of 2-naphthol aniline dye are obtained."
msgstr "Deep red crystals of 2-naphthol <br>aniline dye are obtained."

#: simcontrols.js:80
msgid "8ml of conc. H2SO4 is added into the conical flask"
msgstr ""
"8ml of Conc. H<sub>2</sub>SO<sub>4</sub> is added <br>into the conical flask."

#: simcontrols.js:81
msgid "Acetanilide + Glacial acetic acid + Conc. H2SO4"
msgstr "Acetanilide + Glacial acetic acid + Conc. H<sub>2</sub>SO<sub>4</sub>"

#: simcontrols.js:82
msgid "Fuming HNO3 (2 ml) + Conc. H2SO4 (2 ml)"
msgstr ""
"Fuming HNO<sub>3</sub> (2 ml) + Conc. H<sub>2</sub>SO<sub>4</sub> (2 ml)"

