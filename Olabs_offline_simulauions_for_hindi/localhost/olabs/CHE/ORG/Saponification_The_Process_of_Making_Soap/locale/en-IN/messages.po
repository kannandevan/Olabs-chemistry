#: simcontrols.js:64
msgid "Click here to see the inference"
msgstr "Click here to see the inference"

#: simcontrols.js:70
msgid "Saponification:The Process of Making Soap"
msgstr "Saponification:The Process of Making Soap"

#: simcontrols.js:71
msgid "Instructions"
msgstr "Instructions"

#: simcontrols.js:72 simcontrols.js:77
msgid ""
"Click on the measuring cylinder containing Coconut oil to pour it into the "
"beaker."
msgstr ""
"Click on the measuring cylinder containing Coconut oil to pour it into the "
"beaker."

#: simcontrols.js:73
msgid "Reset"
msgstr "Reset"

#: simcontrols.js:74
msgid "Coconut oil(25ml)"
msgstr "Coconut oil(25ml)"

#: simcontrols.js:75
msgid "(20%) NaOH solution(30ml)"
msgstr "(20%) NaOH solution(30ml)"

#: simcontrols.js:101 simcontrols.js:426
msgid ""
"Click on the measuring cylinder containing Sodium Hydroxide to pour it into "
"the beaker."
msgstr ""
"Click on the measuring cylinder containing Sodium Hydroxide to pour it into "
"the beaker."

#: simcontrols.js:124 simcontrols.js:444
msgid "Click on the glass rod to stir the mixture."
msgstr "Click on the glass rod to stir the mixture."

#: simcontrols.js:148
msgid "Click on the beaker to heat the mixture"
msgstr "Click on the beaker to heat the mixture"

#: simcontrols.js:172
msgid "Click on the beaker to remove it from the Bunsen burner."
msgstr "Click on the beaker to remove it from the Bunsen burner."

#: simcontrols.js:197
msgid "Click on the red litmus paper to dip it into the soap suspension."
msgstr "Click on the red litmus paper to dip it into the soap suspension."

#: simcontrols.js:220
msgid "Click on the blue litmus paper to dip it into the soap suspension."
msgstr "Click on the blue litmus paper to dip it into the soap suspension."

#: simcontrols.js:243
msgid "Click on the watch glass to add common salt to the soap suspension."
msgstr "Click on the watch glass to add common salt to the soap suspension."

#: simcontrols.js:266 simcontrols.js:626
msgid "Click on the glass rod to stir the contents."
msgstr "Click on the glass rod to stir the contents."

#: simcontrols.js:289 simcontrols.js:510
msgid "Click on the beaker to filter the contents."
msgstr "Click on the beaker to filter the contents."

#: simcontrols.js:312
msgid "Click on the Spatula to take soap from the funnel."
msgstr "Click on the Spatula to take soap from the funnel."

#: simcontrols.js:336 simcontrols.js:676
msgid "Click on the filter paper to dry the soap."
msgstr "Click on the filter paper to dry the soap."

#: simcontrols.js:359
msgid "Click here to turn on the burner."
msgstr "Click here to turn on the burner."

#: simcontrols.js:382
msgid "Click here to turn off the burner."
msgstr "Click here to turn off the burner."

#: simcontrols.js:463 simcontrols.js:642
msgid ""
"Click on the information icon to see the inference.</br></br>Click on the "
"'NEXT STEP' icon to go to the next process."
msgstr ""
"Click on the information icon to see the inference.</br></br>Click on the "
"'NEXT STEP' icon to go to the next process."

#: simcontrols.js:479
msgid "Turn on the burner by clicking the knob of the burner."
msgstr "Turn on the burner by clicking the knob of the burner."

#: simcontrols.js:487
msgid ""
"Click on the red litmus paper to dip it into the soap suspension.<br/><br/"
">Click on the information icon to see the inference.</br></br> Then click on "
"the blue litmus paper to dip it into the soap suspension."
msgstr ""
"Click on the red litmus paper to dip it into the soap suspension.<br/><br/"
">Click on the information icon to see the inference.</br></br> Then click on "
"the blue litmus paper to dip it into the soap suspension."

#: simcontrols.js:548
msgid ""
"Click on the information icon to see the inference.</br></br>Click on the "
"beaker to remove it from the Bunsen burner for allow it to cool."
msgstr ""
"Click on the information icon to see the inference.</br></br>Click on the "
"beaker to remove it from the Bunsen burner for allow it to cool."

#: simcontrols.js:564
msgid "Turn off the burner by clicking the knob of the burner. "
msgstr "Turn off the burner by clicking the knob of the burner. "

#: simcontrols.js:604
msgid ""
"Click on the information icon to see the inference.<br/><br/>Click on the "
"watch glass to add common salt to the soap suspension."
msgstr ""
"Click on the information icon to see the inference.<br/><br/>Click on the "
"watch glass to add common salt to the soap suspension."

#: simcontrols.js:660
msgid "Click on the spatula to take soap from the funnel."
msgstr "Click on the spatula to take soap from the funnel."

#: simcontrols.js:694
msgid ""
"Click on the information icon to see the inference.</br></br>Soap is "
"prepared."
msgstr ""
"Click on the information icon to see the inference.</br></br>Soap is "
"prepared."

#: simcontrols.js:707
msgid "Click on the beaker to heat the mixture."
msgstr "Click on the beaker to heat the mixture."

#: simcontrols.js:716
msgid "Click on the 'NEXT STEP' icon to go to the next process."
msgstr "Click on the 'NEXT STEP' icon to go to the next process."

#: simcontrols.js:729
msgid ""
"The reaction between vegetable oil and sodium hydroxide solution is "
"exothermic."
msgstr ""
"The reaction between vegetable oil and sodium hydroxide solution is "
"exothermic."

#: simcontrols.js:731
msgid ""
"Whitish paste is formed and is made up of soap (suspension) and glycerol."
msgstr ""
"Whitish paste is formed and is made up of soap (suspension) and glycerol."

#: simcontrols.js:733
msgid ""
"Red litmus changes to blue indicating that soap solution is basic in nature."
msgstr ""
"Red litmus changes to blue indicating that soap solution is basic in nature."

#: simcontrols.js:735
msgid ""
"No change in the colour of blue litmus indicating that soap suspension is "
"not acidic in nature."
msgstr ""
"No change in the colour of blue litmus indicating that soap suspension is "
"not acidic in nature."

#: simcontrols.js:737
msgid ""
"After adding common salt, soap in the suspension gets precipitated out as "
"solid."
msgstr ""
"After adding common salt, soap in the suspension gets precipitated out as "
"solid."

#: simcontrols.js:739
msgid "Soap is prepared."
msgstr "Soap is prepared."

