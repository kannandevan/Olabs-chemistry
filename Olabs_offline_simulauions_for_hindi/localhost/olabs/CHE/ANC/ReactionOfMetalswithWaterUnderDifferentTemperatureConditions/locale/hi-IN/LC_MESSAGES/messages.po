#: simcontrols.js:143
msgid "<strong>Sodium reacts violently with cold water.The reaction</strong>"
msgstr "<strong>सोडियम ठंडे पानी के साथ बहुत तीव्रता से अभिक्रिया करता है। यह अभिक्रिया</strong>"

#: simcontrols.js:144
msgid "<strong>is so violent and exothermic in the case of sodium</strong>"
msgstr "<strong>सोडियम के मामले में इतनी तीव्र और ऊष्माक्षेपी होती है कि</strong>"

#: simcontrols.js:145
msgid "<strong>that the evolved hydrogen immediately catches fire.</strong>"
msgstr "<strong>उत्पन्न हाइड्रोजन तुरंत आग पकड़ लेता है।</strong>"

#: simcontrols.js:146
msgid ""
"<strong>2Na<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → 2N<sub>a</sub>OH<sub>(aq)</sub> + "
"H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>2Na<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → 2NaOH<sub>(aq)</sub> + H<sub>2(g)</"
"sub></strong>"

#: simcontrols.js:147
msgid "<strong>Magnesium does not react with cold water. It reacts with </strong>"
msgstr "<strong>मैग्नीशियम ठंडे पानी के साथ अभिक्रिया नहीं करता। यह अभिक्रिया करता है </strong>"

#: simcontrols.js:148
msgid "<strong>hot water to form magnesium hydroxide and hydrogen. It </strong>"
msgstr "<strong>गर्म पानी के साथ, जिससे मैग्नीशियम हाइड्रॉक्साइड और हाइड्रोजन बनते हैं। यह </strong>"

#: simcontrols.js:149
msgid "<strong>also starts floating due to the bubbles of hydrogen gas </strong>"
msgstr "<strong>हाइड्रोजन गैस के बुलबुलों के कारण सतह पर तैरने लगता है </strong>"

#: simcontrols.js:150
msgid "<strong>sticking to its surface.</strong>"
msgstr "<strong>जो उसकी सतह से चिपके रहते हैं।</strong>"

#: simcontrols.js:151
msgid ""
"<strong>Mg<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub>→ Mg(OH)<sub>2(aq)</sub> + H<sub>2(g)</"
"sub></strong>"
msgstr ""
"<strong>Mg<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → Mg(OH)<sub>2(aq)</sub> + H<sub>2(g)</"
"sub></strong>"

#: simcontrols.js:152
msgid "<strong>Metals like aluminium, iron and zinc do not react either</strong>"
msgstr "<strong>एल्युमिनियम, लोहा और जिंक जैसी धातुएं न तो</strong>"

#: simcontrols.js:153
msgid "<strong>with cold or hot water. But they react with steam to form</strong>"
msgstr "<strong>ठंडे या गर्म पानी के साथ अभिक्रिया करती हैं, बल्कि भाप के साथ अभिक्रिया करके</strong>"

#: simcontrols.js:154
msgid "<strong>metal oxide and hydrogen gas.</strong>"
msgstr "<strong>धातु ऑक्साइड और हाइड्रोजन गैस बनाती हैं।</strong>"

#: simcontrols.js:155
msgid ""
"<strong>&nbsp;&nbsp;2Al<sub>(s)</sub> + 3H<sub>2</sub>O<sub>(g)</sub> → Al<sub>2</sub>O<sub>3(s)</"
"sub> + 3H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;2Al<sub>(s)</sub> + 3H<sub>2</sub>O<sub>(g)</sub> → Al<sub>2</sub>O<sub>3(s)</"
"sub> + 3H<sub>2(g)</sub></strong>"

#: simcontrols.js:156
msgid ""
"<strong>&nbsp;&nbsp;3Fe<sub>(s)</sub> + 4H<sub>2</sub>O<sub>(g)</sub> → Fe<sub>3</sub>O<sub>4(s)</"
"sub> + 4H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;3Fe<sub>(s)</sub> + 4H<sub>2</sub>O<sub>(g)</sub> → Fe<sub>3</sub>O<sub>4(s)</"
"sub> + 4H<sub>2(g)</sub></strong>"

#: simcontrols.js:157
msgid ""
"<strong>&nbsp;&nbsp;Zn<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → Zn(OH)<sub>2(aq)</sub> + "
"H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;Zn<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → Zn(OH)<sub>2(aq)</sub> + "
"H<sub>2(g)</sub></strong>"

#: simcontrols.js:158
msgid "<strong>Metals like lead and copper do not react with cold water,</strong>"
msgstr "<strong>सीसा (लेड) और तांबा जैसी धातुएं ठंडे पानी के साथ अभिक्रिया नहीं करतीं,</strong>"

