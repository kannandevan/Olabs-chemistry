#: simcontrols.js:143
msgid "<strong>Sodium reacts violently with cold water.The reaction</strong>"
msgstr "<strong>Sodium reacts violently with cold water.The reaction</strong>"

#: simcontrols.js:144
msgid "<strong>is so violent and exothermic in the case of sodium</strong>"
msgstr "<strong>is so violent and exothermic in the case of sodium</strong>"

#: simcontrols.js:145
msgid "<strong>that the evolved hydrogen immediately catches fire.</strong>"
msgstr "<strong>that the evolved hydrogen immediately catches fire.</strong>"

#: simcontrols.js:146
msgid ""
"<strong>2Na<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → 2N<sub>a</"
"sub>OH<sub>(aq)</sub> + H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>2Na<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → 2N<sub>a</"
"sub>OH<sub>(aq)</sub> + H<sub>2(g)</sub></strong>"

#: simcontrols.js:147
msgid ""
"<strong>Magnesium does not react with cold water. It reacts with </strong>"
msgstr ""
"<strong>Magnesium does not react with cold water. It reacts with </strong>"

#: simcontrols.js:148
msgid "<strong>hot water to form magnesium hydroxide and hydrogen. It </strong>"
msgstr ""
"<strong>hot water to form magnesium hydroxide and hydrogen. It </strong>"

#: simcontrols.js:149
msgid ""
"<strong>also starts floating due to the bubbles of hydrogen gas </strong>"
msgstr ""
"<strong>also starts floating due to the bubbles of hydrogen gas </strong>"

#: simcontrols.js:150
msgid "<strong>sticking to its surface.</strong>"
msgstr "<strong>sticking to its surface.</strong>"

#: simcontrols.js:151
msgid ""
"<strong>Mg<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub>→ Mg(OH)<sub>2(aq)</"
"sub> + H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>Mg<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub>→ Mg(OH)<sub>2(aq)</"
"sub> + H<sub>2(g)</sub></strong>"

#: simcontrols.js:152
msgid ""
"<strong>Metals like aluminium, iron and zinc do not react either</strong>"
msgstr ""
"<strong>Metals like aluminium, iron and zinc do not react either</strong>"

#: simcontrols.js:153
msgid ""
"<strong>with cold or hot water. But they react with steam to form</strong>"
msgstr ""
"<strong>with cold or hot water. But they react with steam to form</strong>"

#: simcontrols.js:154
msgid "<strong>metal oxide and hydrogen gas.</strong>"
msgstr "<strong>metal oxide and hydrogen gas.</strong>"

#: simcontrols.js:155
msgid ""
"<strong>&nbsp;&nbsp;2Al<sub>(s)</sub> + 3H<sub>2</sub>O<sub>(g)</sub> → "
"Al<sub>2</sub>O<sub>3(s)</sub> + 3H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;2Al<sub>(s)</sub> + 3H<sub>2</sub>O<sub>(g)</sub> → "
"Al<sub>2</sub>O<sub>3(s)</sub> + 3H<sub>2(g)</sub></strong>"

#: simcontrols.js:156
msgid ""
"<strong>&nbsp;&nbsp;3Fe<sub>(s)</sub> + 4H<sub>2</sub>O<sub>(g)</sub> → "
"Fe<sub>3</sub>O<sub>4(s)</sub> + 4H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;3Fe<sub>(s)</sub> + 4H<sub>2</sub>O<sub>(g)</sub> → "
"Fe<sub>3</sub>O<sub>4(s)</sub> + 4H<sub>2(g)</sub></strong>"

#: simcontrols.js:157
msgid ""
"<strong>&nbsp;&nbsp;Zn<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → "
"Zn(OH)<sub>2(aq)</sub> + H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;Zn<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → "
"Zn(OH)<sub>2(aq)</sub> + H<sub>2(g)</sub></strong>"

#: simcontrols.js:158
msgid ""
"<strong>Metals like lead and copper do not react with cold water,</strong>"
msgstr ""
"<strong>Metals like lead and copper do not react with cold water,</strong>"

#: simcontrols.js:159
msgid "<strong>hot water and steam.</strong>"
msgstr "<strong>hot water and steam.</strong>"