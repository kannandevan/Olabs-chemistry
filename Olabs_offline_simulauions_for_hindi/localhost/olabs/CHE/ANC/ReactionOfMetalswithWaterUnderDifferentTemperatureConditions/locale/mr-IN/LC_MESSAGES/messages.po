#: simcontrols.js:143
msgid "<strong>Sodium reacts violently with cold water.The reaction</strong>"
msgstr "<strong>सोडियम थंड पाण्याशी जोरदार प्रतिक्रिया करतो. प्रतिक्रिया</strong>"

#: simcontrols.js:144
msgid "<strong>is so violent and exothermic in the case of sodium</strong>"
msgstr "<strong>सोडियमच्या बाबतीत ती अतिशय तीव्र आणि उष्मीय आहे</strong>"

#: simcontrols.js:145
msgid "<strong>that the evolved hydrogen immediately catches fire.</strong>"
msgstr "<strong>ज्यात निर्माण झालेला हायड्रोजन लगेचच जळतो.</strong>"

#: simcontrols.js:146
msgid ""
"<strong>2Na<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → 2N<sub>a</"
"sub>OH<sub>(aq)</sub> + H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>2Na<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → 2N<sub>a</"
"sub>OH<sub>(aq)</sub> + H<sub>2(g)</sub></strong>"

#: simcontrols.js:147
msgid "<strong>Magnesium does not react with cold water. It reacts with </strong>"
msgstr "<strong>मॅग्नेशियम थंड पाण्याशी प्रतिक्रिया करत नाही. हे </strong>"

#: simcontrols.js:148
msgid "<strong>hot water to form magnesium hydroxide and hydrogen. It </strong>"
msgstr ""
"<strong>गरम पाण्याशी मॅग्नेशियम हायड्रॉक्साईड आणि हायड्रोजन तयार करण्यासाठी प्रतिक्रिया करते. हे "
"</strong>"

#: simcontrols.js:149
msgid "<strong>also starts floating due to the bubbles of hydrogen gas </strong>"
msgstr "<strong>हायड्रोजन वायूच्या बुब्बल्समुळे हे तरंगायला देखील सुरू होते </strong>"

#: simcontrols.js:150
msgid "<strong>sticking to its surface.</strong>"
msgstr "<strong>ज्यामुळे त्याच्या पृष्ठभागाला चिकटते.</strong>"

#: simcontrols.js:151
msgid ""
"<strong>Mg<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub>→ Mg(OH)<sub>2(aq)</sub> + "
"H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>Mg<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub>→ Mg(OH)<sub>2(aq)</sub> + "
"H<sub>2(g)</sub></strong>"

#: simcontrols.js:152
msgid "<strong>Metals like aluminium, iron and zinc do not react either</strong>"
msgstr "<strong>अॅल्युमिनियम, लोखंड आणि झिंक सारख्या धातू देखील प्रतिक्रिया करत नाहीत</strong>"

#: simcontrols.js:153
msgid "<strong>with cold or hot water. But they react with steam to form</strong>"
msgstr ""
"<strong>थंड किंवा गरम पाण्याशी. पण ते वाफेसोबत प्रतिक्रिया करतात ज्यामुळे तयार होते</strong>"

#: simcontrols.js:154
msgid "<strong>metal oxide and hydrogen gas.</strong>"
msgstr "<strong>धातू ऑक्साईड आणि हायड्रोजन वायू.</strong>"

#: simcontrols.js:155
msgid ""
"<strong>&nbsp;&nbsp;2Al<sub>(s)</sub> + 3H<sub>2</sub>O<sub>(g)</sub> → Al<sub>2</"
"sub>O<sub>3(s)</sub> + 3H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;2Al<sub>(s)</sub> + 3H<sub>2</sub>O<sub>(g)</sub> → Al<sub>2</"
"sub>O<sub>3(s)</sub> + 3H<sub>2(g)</sub></strong>"

#: simcontrols.js:156
msgid ""
"<strong>&nbsp;&nbsp;3Fe<sub>(s)</sub> + 4H<sub>2</sub>O<sub>(g)</sub> → Fe<sub>3</"
"sub>O<sub>4(s)</sub> + 4H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;3Fe<sub>(s)</sub> + 4H<sub>2</sub>O<sub>(g)</sub> → Fe<sub>3</"
"sub>O<sub>4(s)</sub> + 4H<sub>2(g)</sub></strong>"

#: simcontrols.js:157
msgid ""
"<strong>&nbsp;&nbsp;Zn<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → "
"Zn(OH)<sub>2(aq)</sub> + H<sub>2(g)</sub></strong>"
msgstr ""
"<strong>&nbsp;&nbsp;Zn<sub>(s)</sub> + 2H<sub>2</sub>O<sub>(l)</sub> → "
"Zn(OH)<sub>2(aq)</sub> + H<sub>2(g)</sub></strong>"

#: simcontrols.js:158
msgid "<strong>Metals like lead and copper do not react with cold water,</strong>"
