#: ../js/simcontrols.js:19
msgid "Click here to stir the ice cubes."
msgstr "ഇവിടെ ക്ലിക്ക് ചെയ്ത് ഐസ് കൃൂബുകൾ ഇളക്കുക."

#: ../js/simcontrols.js:19
