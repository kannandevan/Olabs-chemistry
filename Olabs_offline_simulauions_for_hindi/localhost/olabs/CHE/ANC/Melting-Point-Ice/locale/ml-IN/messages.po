#: ../js/simcontrols.js:17
msgid "Melting Point of Ice"
msgstr "ഐസിൻ്റെ ദ്രവണാങ്കം"

#: ../js/simcontrols.js:18
msgid "At different Pressures"
msgstr "മർദ്ദം(ബാർ)"

