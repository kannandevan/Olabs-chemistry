msgid "Drag and drop<br> 0.6 ml of water <br>to test tube D"
msgstr "0.6 मिली पाणी<br> टेस्ट ट्यूब D मध्ये <br>ड्रॅग आणि ड्रॉप करा"

msgid "Drag and drop<br> 0.8 ml of water <br>to test tube E"
msgstr "0.8 मिली पाणी<br> टेस्ट ट्यूब E मध्ये <br>ड्रॅग आणि ड्रॉप करा"

