msgid "Show that Acids, Bases, and Salts are Electrolytes"
msgstr "<empty class='px8'>അമ്ലങ്ങൾ, ആൽക്കലികൾ, ഉപ്പുകൾ എന്നിവ ഇലക്ട്രോളൈറ്റുകളാണെന്ന് കാണിക്കുക</empty>"

msgid "<u><b>Instructions:</b></u>"
msgstr "<u><b>നിർദ്ദേശങ്ങൾ:</b></u>"

msgid "1. Question and answer &nbsp;&nbsp;&nbsp;&nbsp;session, Click correct answer."
msgstr "<empty class='px8'>1. ചോദ്യോത്തര സെഷൻ, ശരിയായ ഉത്തരത്തിൽ ക്ലിക്ക് ചെയ്യുക.</empty>"

msgid "2. Drag and drop the dropper &nbsp;&nbsp;&nbsp;&nbsp;containing HCl into the &nbsp;&nbsp;&nbsp;&nbsp;beaker A containing water."
msgstr "<empty class='px8'>2. HCl അടങ്ങിയ ഡ്രോപ്പർ വെള്ളമുള്ള ബീക്കർ Aയിൽ വലിച്ചിട്ട് വിടുക.</empty>"

msgid "3. Drag and drop the watchglass &nbsp;&nbsp;&nbsp;&nbsp;containing Sodium Hydroxide &nbsp;&nbsp;&nbsp;&nbsp;into the beaker B."
msgstr "<empty class='px8'>3. സോഡിയം ഹൈഡ്രോക്സൈഡ് അടങ്ങിയ വാച്ച് ഗ്ലാസ് ബീക്കർ Bയിൽ വലിച്ചിട്ട് വിടുക.</empty>"

msgid "4. Drag and drop the watchglass &nbsp;&nbsp;&nbsp;containing Sodium Chloride salt &nbsp;&nbsp;&nbsp;&nbsp;into the beaker C."
msgstr "<empty class='px8'>4. സോഡിയം ക്ലോറൈഡ് ഉപ്പ് അടങ്ങിയ വാച്ച് ഗ്ലാസ് ബീക്കർ Cയിൽ വലിച്ചിട്ട് വിടുക.</empty>"

msgid "5. Click on the Next button."
msgstr "<empty class='px8'>5. നെക്സ്റ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക.</empty>"

msgid "HELP"
msgstr "സഹായം"

msgid "Choose the correct answer"
msgstr "ശരിയായ ഉത്തരം തിരഞ്ഞെടുക്കുക"

msgid "Drag and drop the dropper containing<br> HCl into the beaker A containing water"
msgstr "HCl അടങ്ങിയ ഡ്രോപ്പർ വെള്ളമുള്ള ബീക്കർ Aയിൽ വലിച്ചിട്ട് വിടുക."

msgid "Drag and drop the watchglass containing<br> Sodium Hydroxide into the beaker B"
msgstr "സോഡിയം ഹൈഡ്രോക്സൈഡ് അടങ്ങിയ വാച്ച് ഗ്ലാസ് ബീക്കർ Bയിൽ വലിച്ചിട്ട് വിടുക."

msgid "Drag and drop the watchglass<br> containing Sodium Chloride<br> salt into the beaker C"
msgstr "സോഡിയം ക്ലോറൈഡ് ഉപ്പ് അടങ്ങിയ വാച്ച് ഗ്ലാസ് ബീക്കർ Cയിൽ വലിച്ചിട്ട് വിടുക."

msgid "Click on the Next button"
msgstr "നെക്സ്റ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "Click on the check box<br> to show the circuit diagram"
msgstr "സർക്യൂട്ട് ഡയഗ്രാം കാണിക്കാൻ ചെക്ക് ബോക്സിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "Drag and drop iron nails on rubber cork"
msgstr "ഇരുമ്പ് ആണികൾ റബ്ബർ കോർക്കിൽ വലിച്ചിട്ട് വിടുക."

msgid "Drag the wire from the iron nail<br> to the 6V positive terminal of the<br> battery in the highlighted area"
msgstr "ഇരുമ്പ് ആണിയിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ ബാറ്ററിയുടെ 6V പോസിറ്റീവ് ടെർമിനലിൽ ബന്ധിപ്പിക്കുക."

msgid "Click on the check box<br> to hide the circuit diagram"
msgstr "സർക്യൂട്ട് ഡയഗ്രാം മറയ്ക്കാൻ ചെക്ക് ബോക്സിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "Drag wire from the 6V negative<br> terminal of the battery to the<br> bulb in the highlighted area"
msgstr "ബാറ്ററിയുടെ 6V നെഗറ്റീവ് ടെർമിനലിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ ബൾബിൽ ബന്ധിപ്പിക്കുക."

msgid "Drag the wire from the bulb<br> to the plug key holder<br> in the highlighted area"
msgstr "ബൾബിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ പ്ലഗ് കീ ഹോൾഡറിൽ ബന്ധിപ്പിക്കുക."

msgid "Drag wire from the iron nail<br> to the plug key holder in<br> the highlighted area"
msgstr "ഇരുമ്പ് ആണിയിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ പ്ലഗ് കീ ഹോൾഡറിൽ ബന്ധിപ്പിക്കുക."

msgid "Drag and drop plug<br> key on plug key holder"
msgstr "പ്ലഗ് കീ പ്ലഗ് കീ ഹോൾഡറിൽ വലിച്ചിട്ട് വിടുക."

msgid "Click on the Next button"
msgstr "നെക്സ്റ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "Click on the Reset button to do the experiment again"
msgstr "പ്രയോഗം വീണ്ടും ചെയ്യാൻ റീസെറ്റ് ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "Suppose you are asked to check the electrical conductivity of deionised water, and while doing this experiment, what will be the possible result?"
msgstr "നിങ്ങളോട് ഡീ-ഐയോണൈസ്ഡ് വെള്ളത്തിന്റെ വൈദ്യുത വാഹകത പരിശോധിക്കാൻ പറഞ്ഞാൽ, ഈ പ്രയോഗം നടത്തുമ്പോൾ ലഭിക്കാവുന്ന ഫലമെന്തായിരിക്കും?"

msgid "Bulb glows and fades"
msgstr "ബൾബ് തെളിഞ്ഞ് മങ്ങിയിരിക്കുന്നു"

msgid "Bulb does not glow"
msgstr "ബൾബ് തെളിയുന്നില്ല"

msgid "Bulb glows"
msgstr "ബൾബ് തെളിയുന്നു"

msgid "In this experiment, you are using a sodium hydroxide solution. What will happen when you use the same sodium hydroxide in its solid form? Will it conduct electricity?"
msgstr "ഈ പ്രയോഗത്തിൽ നിങ്ങൾ സോഡിയം ഹൈഡ്രോക്സൈഡ് ലായനം ഉപയോഗിക്കുന്നു. അതേ സോഡിയം ഹൈഡ്രോക്സൈഡ് ഘന രൂപത്തിൽ ഉപയോഗിച്ചാൽ എന്ത് സംഭവിക്കും? അത് വൈദ്യുതി കടത്തുമോ?"

msgid "Yes"
msgstr "അതെ"

msgid "No"
msgstr "ഇല്ല"

msgid "<u>Chemistry Behind the reaction:</u><br>Electrolytes are substances that produce ions when dissolved in water. Because they all produce ions when dissolved in water, they can be classified as acids, bases, or salts. Because of the mobility of the positive and negative ions, known as cations and anions, these solutions transmit electricity.Infer from the observations that acids, bases and salts are electrolytes<br>The following dissociation reactions:.<br>HCl <sub>(aq)</sub> → H+ <sub>(aq)</sub> + Cl- <sub>(aq)</sub><br>NaOH <sub>(aq)</sub> → Na+<sub>(aq)</sub> + OH- <sub>(aq)</sub><br>NaCl <sub>(aq)</sub> → Na+ <sub>(aq)</sub> + Cl-<sub>(aq)</sub>"
msgstr "<u>പ്രതികരണത്തിന് പിന്നിലെ രസതന്ത്രം:</u><br>ഇലക്ട്രോളൈറ്റുകൾ എന്നത് വെള്ളത്തിൽ ലയിക്കുമ്പോൾ അയോണുകൾ സൃഷ്ടിക്കുന്ന പദാർത്ഥങ്ങളാണ്. അവ എല്ലാം വെള്ളത്തിൽ ലയിക്കുമ്പോൾ അയോണുകൾ സൃഷ്ടിക്കുന്നതിനാൽ അവയെ അമ്ലങ്ങൾ, ആൽക്കലികൾ, അല്ലെങ്കിൽ ഉപ്പുകൾ എന്നിങ്ങനെ വർഗ്ഗീകരിക്കാം. കാറ്റിയോണുകളും അനിയോണുകളും എന്നറിയപ്പെടുന്ന പോസിറ്റീവ്, നെഗറ്റീവ് അയോണുകളുടെ ചലനശേഷിയുടെ ഫലമായി ഈ ലായനങ്ങൾ വൈദ്യുതി കടത്തുന്നു. നിരീക്ഷണങ്ങളിൽ നിന്ന് അമ്ലങ്ങൾ, ആൽക്കലികൾ, ഉപ്പുകൾ എന്നിവ ഇലക്ട്രോളൈറ്റുകളാണെന്ന് നിഗമനം ചെയ്യുക.<br>താഴെ കാണുന്ന വിഭജന പ്രതികരണങ്ങൾ:<br>HCl <sub>(aq)</sub> → H+ <sub>(aq)</sub> + Cl- <sub>(aq)</sub><br>NaOH <sub>(aq)</sub> → Na+<sub>(aq)</sub> + OH- <sub>(aq)</sub><br>NaCl <sub>(aq)</sub> → Na+ <sub>(aq)</sub> + Cl-<sub>(aq)</sub>"

msgid "&nbsp;&nbsp;1. Drag and drop iron nails on &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;rubber cork."
msgstr "1. ഇരുമ്പ് ആണികൾ റബ്ബർ കോർക്കിൽ വലിച്ചിട്ട് വിടുക."

msgid "&nbsp;&nbsp;2. Drag the wire from the iron &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;nail to the 6V positive terminal &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;of the battery in the &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;highlighted area."
msgstr "2. ഇരുമ്പ് ആണിയിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ ബാറ്ററിയുടെ 6V പോസിറ്റീവ് ടെർമിനലിൽ ബന്ധിപ്പിക്കുക."

msgid "&nbsp;&nbsp;3. Drag wire from the 6V &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;negative terminal of the &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;battery to the bulb in the &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;highlighted area."
msgstr "3. ബാറ്ററിയുടെ 6V നെഗറ്റീവ് ടെർമിനലിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ ബൾബിൽ ബന്ധിപ്പിക്കുക."

msgid "&nbsp;&nbsp;4. Drag the wire from the &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;bulb to the plug key holder &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;in the highlighted area."
msgstr "4. ബൾബിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ പ്ലഗ് കീ ഹോൾഡറിൽ ബന്ധിപ്പിക്കുക."

msgid "&nbsp;&nbsp;5. Drag wire from the iron &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;nail to the plug key holder &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;in the highlighted area."
msgstr "5. ഇരുമ്പ് ആണിയിൽ നിന്ന് വയർ വലിച്ച് ഹൈലൈറ്റ് ചെയ്ത ഭാഗത്തിലെ പ്ലഗ് കീ ഹോൾഡറിൽ ബന്ധിപ്പിക്കുക."

msgid "&nbsp;&nbsp;6. Drag and drop plug key on &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;plug key holder."
msgstr "6. പ്ലഗ് കീ പ്ലഗ് കീ ഹോൾഡറിൽ വലിച്ചിട്ട് വിടുക."

msgid "&nbsp;&nbsp;7. Click on the Next button."
msgstr "7. അടുത്ത ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "&nbsp;&nbsp;1.Drag and drop plug key on &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;plug key holder. "
msgstr "1. പ്ലഗ് കീ പ്ലഗ് കീ ഹോൾഡറിലേക്ക് വലിച്ച് വിടുക."

msgid "&nbsp;&nbsp;2. Click on the Next button."
msgstr "2. അടുത്ത ബട്ടണിൽ ക്ലിക്ക് ചെയ്യുക."

msgid "&nbsp;&nbsp;1.Time to think."
msgstr "1. ചിന്തിക്കാനുള്ള സമയം."

msgid "HCl"
msgstr "HCl"

msgid "Sodium Hydroxide"
msgstr "<empty class='px8'>സോഡിയം ഹൈഡ്രോക്സൈഡ്</empty>"

msgid "Sodium Chloride"
