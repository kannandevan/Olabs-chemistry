#: simcontrols.js:22
msgid "The insoluble impurities are left on the filter paper."
msgstr "The insoluble impurities are left on the filter paper."

#: simcontrols.js:22
#, fuzzy
msgid ""
"The appearance of a crust or tiny crystals on the side of the <br> china "
"dish shows that the crystallisation point has reached."
msgstr ""
"The appearance of a crust or tiny crystals on the side of the <br> china "
"dish shows that the crystallisation point has reached."

#: simcontrols.js:22
msgid "Crystals of the sample is formed."
msgstr "Crystals of the sample is formed."

#: simcontrols.js:22
msgid "The watch glass contains dried crystals."
msgstr "The watch glass contains dried crystals."

#: simcontrols.js:22
msgid ""
"The crystals of copper sulphate are <br> triclinic, transparent and blue."
msgstr ""
"The crystals of copper sulphate are <br> triclinic, transparent and blue."

#: simcontrols.js:22
msgid ""
"The crystals of potash alum are <br> colourless, transparent and octahedral."
msgstr ""
"The crystals of potash alum are <br> colourless, transparent and octahedral."

#: simcontrols.js:22
msgid "The crystals of benzoic acid are <br> opaque and white."
msgstr "The crystals of benzoic acid are <br> opaque and white."

#: simcontrols.js:22
msgid "Crystals of benzoic acid is left <br> behind on the filter paper."
msgstr "Crystals of benzoic acid is left <br> behind on the filter paper."

#: simcontrols.js:23
msgid "Click on the sample icon <br> to choose the sample."
msgstr "Click on the sample icon <br> to choose the sample."

#: simcontrols.js:23
msgid "Drag the spatula and add <br> sample into the beaker."
msgstr "Drag the spatula and add <br> sample into the beaker."

#: simcontrols.js:23
msgid "Click on the glass rod <br> to stir the solution."
msgstr "Click on the glass rod <br> to stir the solution."

#: simcontrols.js:23
#, fuzzy
msgid ""
"Drag the measuring cylinder and <br> add H<sub>2</sub>SO<sub>4</sub> into "
"the beaker."
msgstr ""
"Drag the measuring cylinder and <br> add H<sub>2</sub>SO<sub>4</sub> into "
"the beaker."

#: simcontrols.js:23
msgid ""
"Drag the beaker and pour<br> the solution into the china dish <br> through "
"the funnel and glass rod."
msgstr ""
"Drag the beaker and pour<br> the solution into the china dish <br> through "
"the funnel and glass rod."

#: simcontrols.js:23
msgid "Click on the burner knob <br>  to turn on the burner."
msgstr "Click on the burner knob <br>  to turn on the burner."

#: simcontrols.js:23
#, fuzzy
msgid ""
"Drag the china dish to <br> transfer the hot saturated solution <br> into "
"the crystallising dish."
msgstr ""
"Drag the china dish to <br> transfer the hot saturated solution <br> into "
"the crystallising dish."

#: simcontrols.js:23
#, fuzzy
msgid "Drag the crystallisation dish <br> and place it into the  trough."
msgstr "Drag the crystallisation dish <br> and place it into the  trough."

#: simcontrols.js:23
#, fuzzy
msgid "Drag the crystallisation dish <br> and place it back."
msgstr "Drag the crystallisation dish <br> and place it back."

#: simcontrols.js:23
msgid "Drag the filter paper and put <br> the crystals into the test tube."
msgstr "Drag the filter paper and put <br> the crystals into the test tube."

#: simcontrols.js:23
#, fuzzy
msgid "Drag the cork and close the test tube."
msgstr "Drag the cork and close the test tube."

#: simcontrols.js:23
#, fuzzy
msgid "Click on the test tube to see<br>  the zoomed view of the sample."
msgstr "Click on the test tube to see<br>  the zoomed view of the sample."

#: simcontrols.js:23
msgid "Drag the beaker and <br> place it into the trough."
msgstr "Drag the beaker and <br> place it into the trough."

#: simcontrols.js:23
msgid "Drag the beaker and <br> place it back."
msgstr "Drag the beaker and <br> place it back."

#: simcontrols.js:23
msgid "Drag the bottle and add <br> solution into the crystallisation dish."
msgstr "Drag the bottle and add <br> solution into the crystallisation dish."

#: simcontrols.js:23
msgid ""
"Drag the crystallisation dish and decant <br> the upper solution to the "
"trough."
msgstr ""
"Drag the crystallisation dish and decant <br> the upper solution to the "
"trough."

#: simcontrols.js:23
msgid ""
"Drag the beaker and pour<br> the solution into the beaker <br> through the "
