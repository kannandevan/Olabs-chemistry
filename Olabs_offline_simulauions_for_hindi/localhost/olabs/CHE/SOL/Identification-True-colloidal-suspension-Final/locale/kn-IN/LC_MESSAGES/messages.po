#: simcontrols.js:10
msgid "Distinguish Between Solutions"
msgstr "ದ್ರಾವಣಗಳ ನಡುವಿನ ವ್ಯತ್ಯಾಸ"

#: simcontrols.js:11
msgid "HELP"
msgstr "HELP"

