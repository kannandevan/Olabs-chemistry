#: simcontrols.js:87
msgid "Drag the china dish and place it over the burner"
msgstr "Drag the china dish and</br>place it over the burner"

#: simcontrols.js:87
msgid ""
"Drag the funnel and place it over the china dish to collect the compound."
msgstr ""
"Drag the funnel and place it</br>over the china dish to collect</br>the "
"compound."

#: simcontrols.js:87
msgid ""
"Drag the spatula to the funnel to collect the compound and drag it to the "
"watch glass to place the compound in it"
msgstr ""
"Drag the spatula to the funnel</br>to collect the compound and drag</br>it "
"to the watch glass to</br>place the compound in it."

#: simcontrols.js:87
msgid ""
"To transfer the mixture into the beaker containing water, drag the china "
"dish over it."
msgstr ""
"To transfer the mixture into the</br>beaker containing water, drag</br>the "
"china dish over it."

#: simcontrols.js:87
msgid "Click on the glass  rod to stir the solution."
msgstr "Click on the glass </br>rod to stir the solution."

#: simcontrols.js:87
msgid ""
"Drag the beaker over the funnel to collect the residue in the filter paper."
msgstr ""
"Drag the beaker over</br>the funnel to collect the</br>residue in the filter "
"paper."

#: simcontrols.js:87
msgid ""
"Drag the spatula to the funnel to collect the compound and drag it to the "
"watch glass to place the compound in it."
msgstr ""
"Drag the spatula to the funnel</br>to collect the compound and drag</br>it "
"to the watch glass to</br>place the compound in it."

#: simcontrols.js:87
msgid ""
"To pour the filtrate from the beaker to the china dish, drag  the beaker "
"over the china dish"
msgstr ""
"To pour the filtrate from the</br>beaker to the china dish, drag </br>the "
"beaker over the china dish."

#: simcontrols.js:87
msgid ""
"Drag the spatula over the china dish to collect the compound and drag it to "
"the watch glass to place the compound in it."
msgstr ""
"Drag the spatula over the</br>china dish to collect the</br>compound and "
"drag it to the</br>watch glass to place the</br>compound in it."

#: simcontrols.js:88
msgid "Naphthalene is separated by the process of sublimation."
msgstr "Naphthalene is separated by the process of sublimation."

#: simcontrols.js:88
msgid "Anthracene is separated by the process of sublimation."
msgstr "Anthracene is separated by the process of sublimation."

#: simcontrols.js:88
msgid "Camphor is separated by the process of sublimation."
msgstr "Camphor is separated by the process of sublimation."

#: simcontrols.js:88
msgid "Ammonium Chloride is separated by the process of sublimation."
msgstr "Ammonium Chloride is separated by the process of sublimation."

#: simcontrols.js:88
msgid "Sand is separated by the process of filtration."
msgstr "Sand is separated by the process of filtration."

#: simcontrols.js:88
msgid "Soil is separated by the process of filtration."
msgstr "Soil is separated by the process of filtration."

#: simcontrols.js:88
msgid "Salt is separated by the process of evaporation."
msgstr "Salt is separated by the process of evaporation."

#: simcontrols.js:88
msgid "Sugar is separated by the process of evaporation."
msgstr "Sugar is separated by the process of evaporation."

#: simcontrols.js:88
msgid "Carefully heat sugar solution"
msgstr ""
"Carefully heat sugar solution because</br>under intense heat, sugar "
"decomposes."

#: simcontrols.js:92
